@* Root document for the whole app. Rendered statically; the pages inside are interactive.
   data-theme picks the palette in AppStyles; Settings reloads the page after changing it. *@
@inject InventoryTracker.App.TrackerOptions Options
<!DOCTYPE html>
<html lang="en" data-theme="@Options.Theme.ToString().ToLowerInvariant()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inventory Tracker - Every station. Every SCU box. Tracked.</title>
    <base href="/" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <AppStyles />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    @* Ctrl+K opens the command palette from anywhere, as a click on the sidebar's "Go to"
       button: the palette lives in that interactive component, and a click is all it needs. *@
    <script>
        document.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && !e.altKey && !e.shiftKey && e.key.toLowerCase() === 'k') {
                var trigger = document.getElementById('palette-trigger');
                if (trigger) { e.preventDefault(); trigger.click(); }
            }
        });
    </script>
</body>
</html>
