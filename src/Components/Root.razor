@* Root document for the whole app. Rendered statically; the pages inside are interactive.
   data-theme picks the palette in AppStyles; Settings reloads the page after changing it. *@
@inject InventoryTracker.App.TrackerOptions Options
<!DOCTYPE html>
<html lang="en" data-theme="@Options.Theme.ToString().ToLowerInvariant()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inventory Tracker - Every station. Every SCU box. Tracked.</title>
    <base href="/" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <AppStyles />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
