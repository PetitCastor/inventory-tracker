@* Styles live in a component rather than wwwroot/app.css so that a single-file
   publish really is a single file — static web assets stay loose on disk. *@
<style>
    /* Dark is the base palette. Root.razor sets data-theme from Settings: "light" always uses the
       light palette, "system" uses it when Windows (or the browser) prefers light. The app
       window's WebView2 reports the Windows setting as prefers-color-scheme. */
    :root {
        color-scheme: dark;
        --bg: #0e1116;
        --panel: #161b22;
        --line: #262c36;
        --text: #e6edf3;
        --muted: #8b949e;
        --accent: #4dabf7;
        --on-accent: #0b1220;
        --high: #3fb950;
        --medium: #d29922;
        --low: #f85149;
    }

    :root[data-theme="light"] {
        color-scheme: light;
        --bg: #f6f8fa;
        --panel: #ffffff;
        --line: #d0d7de;
        --text: #1f2328;
        --muted: #59636e;
        --accent: #0969da;
        --on-accent: #ffffff;
        --high: #1a7f37;
        --medium: #9a6700;
        --low: #cf222e;
    }

    @@media (prefers-color-scheme: light) {
        :root[data-theme="system"] {
            color-scheme: light;
            --bg: #f6f8fa;
            --panel: #ffffff;
            --line: #d0d7de;
            --text: #1f2328;
            --muted: #59636e;
            --accent: #0969da;
            --on-accent: #ffffff;
            --high: #1a7f37;
            --medium: #9a6700;
            --low: #cf222e;
        }
    }

    * { box-sizing: border-box; }

    body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 15px/1.5 "Segoe UI", system-ui, sans-serif;
    }

    /* The window frame: sidebar on the left, the page scrolling beside it, and the status bar
       pinned along the bottom. Only the main element scrolls, so the chrome never moves. */
    .app-shell { display: grid; grid-template-columns: 13.5rem minmax(0, 1fr); height: 100vh; }
    .app-body { display: flex; flex-direction: column; min-width: 0; min-height: 0; }

    /* Full width: the item grid uses all of the window it is given. */
    main { flex: 1; min-height: 0; overflow-y: auto; padding: 1.25rem 1.5rem 3rem; }

    .sidebar {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-height: 0;
        overflow-y: auto;
        padding: 0.9rem 0.6rem 0.6rem;
        background: var(--panel);
        border-right: 1px solid var(--line);
    }

    .sidebar .brand {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.1rem 0.55rem;
        color: var(--text);
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
    }
    .sidebar .brand-icon { width: 1.25rem; height: 1.25rem; border-radius: 4px; flex: none; }

    .palette-trigger {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        width: 100%;
        padding: 0.4rem 0.55rem;
        background: var(--bg);
        color: var(--muted);
        font-size: 0.85rem;
        text-align: left;
    }
    .palette-trigger svg { width: 1rem; height: 1rem; flex: none; }
    .palette-trigger .nav-label { flex: 1; }

    kbd {
        padding: 0.05rem 0.35rem;
        border: 1px solid var(--line);
        border-radius: 4px;
        font: 0.7rem "Segoe UI", system-ui, sans-serif;
        color: var(--muted);
        white-space: nowrap;
    }

    .side-nav { display: flex; flex-direction: column; gap: 0.1rem; }
    .side-nav-end { margin-top: auto; }
    .side-nav a {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.45rem 0.55rem;
        border-radius: 6px;
        color: var(--muted);
        text-decoration: none;
        font-size: 0.95rem;
        white-space: nowrap;
    }
    .side-nav a:hover { color: var(--text); background: var(--bg); }
    .side-nav a.active { color: var(--text); background: var(--bg); box-shadow: inset 2px 0 0 var(--accent); }
    .side-nav svg { width: 1.1rem; height: 1.1rem; flex: none; }
    .nav-count { margin-left: auto; font-size: 0.75rem; color: var(--muted); font-variant-numeric: tabular-nums; }

    .status-bar {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        height: 1.85rem;
        flex: none;
        padding: 0 0.4rem 0 0.9rem;
        background: var(--panel);
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.78rem;
        white-space: nowrap;
    }
    .status-item { display: inline-flex; align-items: center; gap: 0.45rem; overflow: hidden; text-overflow: ellipsis; }
    a.status-item { color: inherit; text-decoration: none; }
    a.status-item:hover { color: var(--text); }
    .status-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; flex: none; background: var(--muted); }
    .status-ok { background: var(--high); }
    .status-warn { background: var(--medium); }
    .status-error { background: var(--low); }
    /* The two versions sit together at the right end, before the theme toggle; the first one
       present takes the auto margin that pushes the group right. */
    .status-bar .game-version, .status-bar .app-version { margin-left: auto; }
    .status-bar .game-version + .app-version { margin-left: 0; }
    .status-bar .app-version + .theme-toggle { margin-left: 0; }

    .theme-toggle {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.6rem;
        height: 1.6rem;
        padding: 0;
        background: none;
        border: 1px solid transparent;
        border-radius: 6px;
        color: var(--muted);
    }
    .theme-toggle:hover { color: var(--text); border-color: var(--line); }
    .theme-toggle svg { width: 0.95rem; height: 0.95rem; }

    /* Ctrl+K: a box near the top of the window, over a dimmed page. */
    .palette-backdrop {
        position: fixed;
        inset: 0;
        z-index: 110;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 12vh 1rem 1rem;
        background: rgba(0, 0, 0, 0.45);
    }
    .palette {
        width: 100%;
        max-width: 36rem;
        display: flex;
        flex-direction: column;
        max-height: 70vh;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 10px;
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.45);
        overflow: hidden;
    }
    .palette-input-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--line); color: var(--muted); }
    .palette-input-row svg { width: 1.1rem; height: 1.1rem; flex: none; }
    .palette-input { flex: 1; min-width: 0; padding: 0; background: none; border: none; outline: none; color: var(--text); font-size: 1rem; }
    .palette-list { list-style: none; margin: 0; padding: 0.35rem; overflow-y: auto; }
    .palette-item { display: flex; align-items: center; gap: 1rem; padding: 0.45rem 0.6rem; border-radius: 6px; cursor: pointer; }
    .palette-item.selected { background: var(--bg); box-shadow: inset 2px 0 0 var(--accent); }
    .palette-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .palette-kind { font-size: 0.78rem; color: var(--muted); white-space: nowrap; }

    h1 { font-size: 1.5rem; margin: 0 0 1rem; }
    h2 { font-size: 1.05rem; margin: 2rem 0 0.6rem; }

    a { color: var(--accent); }

    code { font-family: Consolas, "Cascadia Mono", monospace; font-size: 0.9em; color: var(--muted); }

    /* Search and the station picker on one row; it wraps on a narrow window. */
    .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }

    .picker-field { display: flex; align-items: center; gap: 0.5rem; }

    .picker-icon { width: 1.1rem; height: 1.1rem; flex: none; color: var(--muted); }

    /* Locations: system › station, each part a dropdown that reads as a heading. */
    .location-path { display: flex; align-items: center; gap: 0.2rem; min-width: 0; }
    .location-path .picker-icon { margin-right: 0.3rem; }
    .toolbar select.path-select {
        padding: 0.35rem 0.5rem;
        background: transparent;
        border-color: transparent;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
    }
    .toolbar select.path-select:hover { border-color: var(--line); background: var(--panel); }
    .toolbar select.path-select option { background: var(--panel); font-weight: 400; font-size: 0.95rem; }
    .toolbar select.path-station { min-width: 0; max-width: 24rem; text-overflow: ellipsis; }

    .toolbar select {
        padding: 0.6rem 0.8rem;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--text);
        font-size: 1rem;
    }

    .toolbar select:focus { outline: 2px solid var(--accent); outline-offset: -1px; }

    .search-field { flex: 1 1 18rem; max-width: 28rem; margin-left: auto; }

    /* Quick category filters under the toolbar. */
    .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.25rem; }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        font-size: 0.85rem;
        color: var(--muted);
    }

    .chip:hover { color: var(--text); }
    .chip.active { color: var(--text); border-color: var(--accent); background: rgba(77, 171, 247, 0.12); }
    .chip-count { font-size: 0.75rem; color: var(--muted); font-variant-numeric: tabular-nums; }

    .search-input {
        flex: 1;
        padding: 0.6rem 0.8rem;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--text);
        font-size: 1rem;
    }

    .search-input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }

    /* Health banners on Browse: a standing warning (unrecognised log lines, shown alongside
       real data) versus an informational explanation for why the page below is empty. */
    .banner { padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.25rem; font-size: 0.9rem; }
    .banner-warn { background: rgba(210, 153, 34, 0.12); border: 1px solid rgba(210, 153, 34, 0.35); color: var(--medium); }
    .banner-info { background: var(--panel); border: 1px solid var(--line); color: var(--muted); }
    .banner a { color: var(--accent); }

    /* A one-time notice over the page, such as a character reset; closed by the user. */
    .popup-backdrop {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(0, 0, 0, 0.6);
    }
    .popup {
        position: relative;
        width: 100%;
        max-width: 34rem;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
        padding: 1.25rem 1.5rem;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 10px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
        font-size: 0.95rem;
    }
    .popup h2 { margin: 0 2rem 0.75rem 0; }
    .popup p { margin: 0 0 0.75rem; }
    .popup ul { margin: 0 0 1rem; padding-left: 1.25rem; color: var(--muted); }
    .popup-close {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        padding: 0.1rem 0.55rem;
        background: none;
        border: none;
        color: var(--muted);
        font-size: 1.3rem;
        line-height: 1;
    }
    .popup-close:hover { color: var(--text); }
    .popup-actions { display: flex; justify-content: flex-end; }

    .settings-field {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .settings-field label { width: 12rem; flex: none; color: var(--muted); }

    .settings-field input {
        flex: 1;
        max-width: 28rem;
        padding: 0.5rem 0.7rem;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--text);
        font-size: 0.95rem;
    }

    .settings-field input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }

    /* Text field paired with Browse… and an open-in-Explorer icon button. */
    .input-row { display: flex; align-items: center; gap: 0.5rem; flex: 1; max-width: 34rem; }
    .input-row input { flex: 1; max-width: none; }

    /* A date needs a fraction of a path's width; stretched to 34rem it reads as a text box. */
    .input-row.date-row { max-width: 18rem; }

    .icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.4rem;
        flex: none;
        color: var(--muted);
    }

    .icon-btn:hover { color: var(--text); border-color: var(--accent); }

    .settings-actions { display: flex; align-items: center; gap: 0.75rem; margin: 1rem 0 2rem; }

    button:disabled { opacity: 0.6; cursor: default; }

    .rebuild-status { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--muted); font-size: 0.9rem; }

    .rebuild-status .spinner {
        width: 1rem;
        height: 1rem;
        border: 2px solid var(--line);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    .rebuild-status.done { color: var(--high); }
    .rebuild-status.done .check { width: 1.25rem; height: 1.25rem; }
    .rebuild-status.error { color: var(--low); }

    button {
        padding: 0.55rem 0.9rem;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--text);
        font-size: 0.9rem;
        cursor: pointer;
    }

    button:hover { border-color: var(--accent); }

    /* A button that reads as a link: navigating into a container on Browse changes the view
       in place rather than going to another page. */
    .link-btn {
        padding: 0;
        background: none;
        border: none;
        color: var(--accent);
        font: inherit;
        text-decoration: underline;
    }

    .link-btn:hover { border: none; color: var(--text); }

    .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin-bottom: 0.5rem; }
    .crumb-sep { color: var(--muted); }

    .count, .subtle, .empty { color: var(--muted); font-size: 0.9rem; }

    .qty { color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }

    .place { margin-bottom: 2rem; }

    .place h2 {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--line);
    }

    .badge-count {
        font-size: 0.75rem;
        font-weight: 400;
        color: var(--muted);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.05rem 0.5rem;
    }

    /* Tables stretch to the page; on a narrow screen (see the media query at the end) wide
       chains and long class names scroll inside the table instead of the page. */
    table { width: 100%; border-collapse: collapse; }

    thead th {
        text-align: left;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
        font-weight: 500;
        padding: 0.4rem 0.75rem 0.4rem 0;
    }

    tbody td { padding: 0.4rem 0.75rem 0.4rem 0; border-top: 1px solid var(--line); vertical-align: top; }

    .chain { color: var(--muted); font-size: 0.9rem; }
    .chain-big { font-size: 1.15rem; margin: 0.3rem 0 0.6rem; }
    .when { color: var(--muted); white-space: nowrap; }
    .unnamed { color: var(--medium); margin-left: 0.3rem; cursor: help; }

    /* How an item came to the player (bought, ...), beside its name. A tag, not a category. */
    .tag {
        font-size: 0.7rem;
        margin-left: 0.4rem;
        padding: 0.05rem 0.45rem;
        border-radius: 999px;
        border: 1px solid var(--line);
        color: var(--muted);
        white-space: nowrap;
        cursor: help;
    }

    .tag-bought { color: var(--accent); border-color: rgba(77, 171, 247, 0.4); }

    /* A station whose name is not confirmed yet: what is known, and how to settle it. */
    .place-status {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--line);
        border-left: 3px solid var(--medium);
        border-radius: 6px;
        background: var(--panel);
        font-size: 0.9rem;
    }

    .place-status code { word-break: break-all; }

    .badge-unconfirmed {
        font-size: 0.75rem;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        background: rgba(210, 153, 34, 0.15);
        color: var(--medium);
        white-space: nowrap;
    }

    .place-input { flex: 1 1 16rem; min-width: 0; }

    .conf {
        font-size: 0.75rem;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        white-space: nowrap;
        cursor: help;
    }

    .conf-high { background: rgba(63, 185, 80, 0.15); color: var(--high); }
    .conf-medium { background: rgba(210, 153, 34, 0.15); color: var(--medium); }
    .conf-low { background: rgba(248, 81, 73, 0.15); color: var(--low); }

    .verdict {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        margin: 1rem 0 2rem;
    }

    .verdict h2 { margin-top: 0; font-size: 0.75rem; text-transform: uppercase; color: var(--muted); }

    .caveats { color: var(--medium); font-size: 0.85rem; margin: 0.75rem 0 0; padding-left: 1.1rem; }

    .facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.35rem 1.5rem; margin: 0; }
    .facts dt { color: var(--muted); }
    .facts dd { margin: 0; min-width: 0; }
    .facts dd.warn { color: var(--medium); }

    /* Settings: section nav on the left, the open section's cards on the right. Below 760px
       the nav becomes a row of tabs over the panel. */
    /* Forms stay readable on a wide window: only the item grids use the full width. */
    .settings-layout { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 2rem; align-items: start; max-width: 72rem; }

    .settings-nav { display: flex; flex-direction: column; gap: 0.15rem; position: sticky; top: 1rem; }
    .settings-nav a {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.45rem 0.7rem;
        border-radius: 6px;
        color: var(--muted);
        text-decoration: none;
        font-size: 0.95rem;
    }
    .settings-nav a:hover { color: var(--text); background: var(--panel); }
    .settings-nav a.active { color: var(--text); background: var(--panel); box-shadow: inset 2px 0 0 var(--accent); }
    .settings-nav svg { width: 1.05rem; height: 1.05rem; flex: none; }
    .nav-dot { width: 0.5rem; height: 0.5rem; margin-left: auto; border-radius: 50%; background: var(--medium); }

    .settings-panel h2 { margin: 0 0 0.75rem; font-size: 1.2rem; }
    .settings-panel h3 {
        margin: 1.5rem 0 0.5rem;
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
    }
    .settings-panel h2 + h3 { margin-top: 0; }
    .panel-lead { margin: -0.4rem 0 0.9rem; color: var(--muted); font-size: 0.9rem; }

    .settings-card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; }
    .settings-card > .facts { padding: 0.9rem 1rem; }
    .settings-card > .subtle { margin: 0; padding: 0.9rem 1rem; }

    .setting-row {
        display: grid;
        grid-template-columns: minmax(10rem, 1fr) minmax(0, 1.5fr);
        gap: 0.5rem 1.5rem;
        align-items: center;
        padding: 0.9rem 1rem;
    }
    .setting-row + .setting-row { border-top: 1px solid var(--line); }
    .setting-text { display: flex; flex-direction: column; gap: 0.15rem; }
    .setting-label { color: var(--text); }
    .setting-hint { color: var(--muted); font-size: 0.85rem; }
    .setting-value { color: var(--muted); font-variant-numeric: tabular-nums; }
    .setting-row > .setting-value { justify-self: end; }
    .setting-control { display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; min-width: 0; }

    .setting-control input {
        flex: 1;
        min-width: 0;
        padding: 0.5rem 0.7rem;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--text);
        font-size: 0.95rem;
    }
    .setting-control input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
    .setting-control input.date-input { flex: 0 1 11rem; }

    .settings-card-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        padding: 0.7rem 1rem;
        border-top: 1px solid var(--line);
    }
    .settings-card-footer > :first-child:not(button) { margin-right: auto; }

    button.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 600; }

    /* Settings → Appearance: three cards, one per theme. */
    .theme-choices { display: flex; flex-wrap: wrap; gap: 0.6rem; padding: 0.9rem 1rem; }
    .theme-choice {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.9rem;
        border: 1px solid var(--line);
        border-radius: 8px;
        cursor: pointer;
    }
    .theme-choice:has(input:checked) { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
    .theme-choice input { accent-color: var(--accent); margin: 0; }

    /* "What's new" lists, in the popup after an update and under Settings → Updates. */
    ul.release-notes { margin: 0 0 1rem; padding: 0; list-style: none; }
    .release-notes > li + li { margin-top: 0.9rem; }
    .release-notes h3 { margin: 0 0 0.3rem; font-size: 0.95rem; }
    .release-notes h3 .release-date { color: var(--muted); font-weight: normal; margin-left: 0.4rem; }
