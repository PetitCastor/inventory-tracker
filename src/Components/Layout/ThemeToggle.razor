@rendermode InteractiveServer
@inject TrackerOptions Options
@inject NavigationManager Nav

@* One click moves to the next theme: System, Light, Dark, then System again. The full choice,
   with an explanation, stays in Settings → Appearance. The page reloads after the change, as it
   does there: the palette hangs off the document's data-theme, rendered once per load. *@
<button type="button" class="theme-toggle" title="@Title" aria-label="@Title" disabled="@_saving" @onclick="Next">
    @switch (Options.Theme)
    {
        case AppTheme.Light:
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            break;
        case AppTheme.Dark:
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
            break;
        default:
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" />
            </svg>
            break;
    }
</button>

@code {
    private bool _saving;

    private string Title => $"Theme: {Options.Theme} (click for {NextTheme(Options.Theme)})";

    private static AppTheme NextTheme(AppTheme theme) => theme switch
    {
        AppTheme.System => AppTheme.Light,
        AppTheme.Light => AppTheme.Dark,
        _ => AppTheme.System,
    };

    private async Task Next()
    {
        _saving = true;
        try
        {
            await Options.SetThemeAsync(NextTheme(Options.Theme));
        }
        catch (Exception ex) when (FormOperationErrors.TryGetMessage(ex, out _))
        {
            // Applied for this run already; only remembering it in config.json failed, and
            // Settings → Appearance says so when it happens there.
        }
        finally
        {
            _saving = false;
        }

        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
}
