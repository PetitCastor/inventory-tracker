@inherits LayoutComponentBase
@inject InventoryTracker.App.TrackerOptions Options
@inject InventoryTracker.App.TrackerState State
@inject NavigationManager Nav

@* A desktop app's frame: navigation down the left, the page scrolling on its own beside it,
   and a status bar along the bottom that stays put. *@
<div class="app-shell">
    <AppSidebar />

    <div class="app-body">
        <main>
            @Body
        </main>

        <footer class="status-bar">
            <StatusBar />
            @* The build of the newest log read, so it is the game the inventory was last seen in. *@
            @if (State.Current.Resolver?.LatestBuild is { } build)
            {
                <span class="status-item game-version" title="Game build of the newest log read">
                    @InventoryTracker.Ingest.GameVersionCatalog.Describe(build)
                </span>
            }
            @* The tracker's own version beside the game's, so a bug report or screenshot carries both. *@
            <span class="status-item app-version" title="Inventory Tracker version">
                Inventory Tracker v@(AppVersion)
            </span>
            <ThemeToggle />
        </footer>
    </div>
</div>

@* Not over the setup wizard: a first run has no news, and records its version instead. *@
@if (Options.SetupComplete)
{
    <WhatsNewPopup />
}

@code {
    private static readonly string AppVersion = InventoryTracker.App.UpdateService.CurrentVersion.ToString(3);

    protected override void OnInitialized()
    {
        // First-run gate: until setup is done, every page bounces to the wizard. The path
        // check keeps /setup itself from redirecting to itself. Navigating during static
        // SSR is turned into a real redirect by the framework.
        if (!Options.SetupComplete)
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
            if (!string.Equals(relative, "setup", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("setup");
        }
    }
}
