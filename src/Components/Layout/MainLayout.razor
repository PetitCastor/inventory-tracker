@inherits LayoutComponentBase
@inject InventoryTracker.App.TrackerOptions Options
@inject NavigationManager Nav
@inject InventoryTracker.App.TrackerState State

<header>
    <nav>
        <a href="" class="brand"><img src="favicon.ico" alt="" class="brand-icon" />Inventory Tracker</a>
        <NavLink href="" Match="NavLinkMatch.All">Browse</NavLink>
        <NavLink href="settings">Settings</NavLink>
    </nav>
</header>

@if (State.Drift is { UnparsedLines: > 0 } drift)
{
    <div class="drift-banner" role="alert">
        Star Citizen changed its log format: @drift.UnparsedLines inventory move line(s) could not be read
        (@string.Join(", ", drift.Tags.Keys.Select(t => $"<{t}>"))). Item locations may be out of date until
        the tracker is updated.
    </div>
}

<main>
    @Body
</main>

@code {
    protected override void OnInitialized()
    {
        // First-run gate: until setup is done, every page bounces to the wizard. The path
        // check keeps /setup itself from redirecting to itself. Navigating during static
        // SSR is turned into a real redirect by the framework.
        if (!Options.SetupComplete)
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
            if (!string.Equals(relative, "setup", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("setup");
        }
    }
}
