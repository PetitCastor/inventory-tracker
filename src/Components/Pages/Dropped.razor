@page "/dropped"
@rendermode InteractiveServer
@implements IDisposable
@inject TrackerState State

<PageTitle>Dropped — Star Citizen inventory</PageTitle>

<h1>Dropped <span class="badge-count">@_groups.Sum(g => g.Rows.Sum(r => r.Quantity))</span></h1>

@* A drop out of an equipment slot writes no Type[Drop]: on 2026-10-12 one left three
   "Drop From Container" lines naming the wrong item, another only an INVALID-to-INVALID
   drag. Nothing names what fell, so the ledger keeps such an item equipped until a pickup
   re-attaches or stores it. *@
<p class="subtle">Items dropped from a holster or another equipment slot do not appear here: the game logs no drop for them.</p>

@* Everything the ledger last saw land on the floor and never saw picked up again. The game
   despawns loose items, and nothing in the logs says when, so these are leads, not holdings. *@
@if (_groups.Count == 0)
{
    <p class="empty">Nothing dropped. Items you drop in game are listed here until you pick them up.</p>
}
else
{
    @foreach (var group in _groups)
    {
        <section class="place">
            <h2>@group.Label <span class="badge-count">@group.Rows.Sum(r => r.Quantity)</span></h2>
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Dropped (UTC)</th>
                        <th>Confidence</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in group.Rows)
                {
                    <tr>
                        <td>
                            @if (row.Geid is { } geid)
                            {
                                <a href="item/@geid">@row.Display</a>
                            }
                            else
                            {
                                @row.Display
                            }
                        </td>
                        <td class="qty">@row.Quantity&times;</td>
                        <td class="when">@row.Newest.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <span class="conf conf-@row.Confidence.ToString().ToLowerInvariant()"
                                  title="@string.Join("; ", row.Caveats)">
                                @row.Confidence
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    }
}

@code {
    /// <summary>The items dropped in one place, newest first.</summary>
    private sealed record Group(string Label, DateTimeOffset Newest, IReadOnlyList<Row> Rows);

    /// <summary>
    /// Every unit of one item class dropped in one place: five magazines are one line of 5, as
    /// in a station's table, dated by the newest drop. Only a line that is a single named item
    /// links to it.
    /// </summary>
    private sealed record Row(
        string Display, string? Geid, int Quantity, DateTimeOffset Newest, Confidence Confidence,
        IReadOnlyList<string> Caveats);

    /// <summary>
    /// Pools identical items, newest drop first. Confidence is the least confident unit's: a
    /// line is only as trustworthy as its weakest member. An item with parts is a line of its
    /// own, linking to the page that lists them: pooling two rifles would leave no link to
    /// either's attachments.
    /// </summary>
    private static List<Row> Pool(IEnumerable<NamedHolding> holdings, HoldingResolver? resolver) =>
        holdings
            .GroupBy(h => resolver?.HasParts(h.Holding) == true ? h.Holding.Geid! : h.ClassName, StringComparer.Ordinal)
            .Select(g =>
            {
                var items = g.ToList();
                var quantity = items.Sum(h => h.Holding.Quantity);
                return new Row(
                    items[0].Display,
                    quantity == 1 ? items[0].Holding.Geid : null,
                    quantity,
                    items.Max(h => h.Holding.LastMove),
                    items.Min(h => h.Holding.Confidence),
                    items.SelectMany(h => h.Holding.Caveats).Distinct().ToList());
            })
            .OrderByDescending(r => r.Newest)
            .ToList();

    private List<Group> _groups = [];

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Load();
    }

    /// <summary>
    /// Groups by the place the item fell in, newest drop first, so what was just dropped by
    /// mistake is at the top. A station can go by several ids — a drop out of its inventory
    /// names one, a drop out of a backpack the one the player last arrived under — so ids are
    /// folded to the place's canonical one first. A scope or a magazine on a rifle is listed on
    /// the rifle's page, not here.
    /// </summary>
    private void Load()
    {
        var snapshot = State.Current;
        var resolver = snapshot.Resolver;

        _groups = snapshot.Holdings
            .Where(h => h.Holding.IsDropped && resolver?.IsPart(h.Holding) != true)
            .GroupBy(h => resolver?.Places.ByLocationId(h.Holding.Root!.Key)?.Id ?? h.Holding.Root!.Key)
            .Select(g => new Group(
                g.Key.Length == 0 || resolver is null ? "Unknown place" : resolver.PlaceLabel(g.Key),
                g.Max(h => h.Holding.LastMove),
                Pool(g, resolver)))
            .OrderByDescending(g => g.Newest)
            .ToList();
    }

    private void OnChanged() => InvokeAsync(() => { Load(); StateHasChanged(); });

    public void Dispose() => State.Changed -= OnChanged;
}
