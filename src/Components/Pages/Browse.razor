@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using InventoryTracker.Model
@using InventoryTracker.Ingest
@using InventoryTracker.Naming
@inject TrackerState State
@inject TrackerOptions Options
@inject PlaceNameService Places
@inject LogWatchService Watcher

<PageTitle>Locations — Star Citizen inventory</PageTitle>

@{
    var health = State.Current.Health;
}

@if (Watcher.LastPass?.Incomplete is { } incompleteFiles)
{
    <p class="banner banner-warn">
        Some rotated log files could not be read and will be retried: @incompleteFiles.
        The inventory shown below may be incomplete.
    </p>
}

@* Unrecognised lines are a standing warning, not an emptiness explanation: the parser can
   be silently dropping some moves while still showing plenty of (incomplete) data, so this
   stacks above whatever else the page is doing rather than replacing it. *@
@if (health.UnrecognisedMoveLines > 0)
{
    <p class="banner banner-warn">
        @health.UnrecognisedMoveLines.ToString("N0") inventory move line(s) in your logs couldn't be fully read —
        either Star Citizen's log format has changed, or the game cut a very large multi-item move short.
        Tracking is incomplete.
    </p>
}

@* A character reset starts the player over without a log line; the tracker has started over
   too, and says so once, because the pages would otherwise just look emptied. The popup stays
   until the user closes it, and closing it is remembered in config.json. *@
@if (UnreadReset() is { } reset)
{
    <div class="popup-backdrop" @onkeydown="e => CloseResetOnEscape(e, reset)">
        <div class="popup" role="dialog" aria-modal="true" aria-labelledby="reset-popup-title">
            <button type="button" class="popup-close" title="Close" aria-label="Close"
                    @onclick="() => DismissReset(reset)">&times;</button>
            <h2 id="reset-popup-title">Character reset</h2>
            <p>
                On @FormatDate(reset.ResetAt), with @GameVersionCatalog.Describe(reset.Build), you reset your
                character@(reset.Home is { } home ? $" and chose {home} as your home location" : "").
            </p>
            <p>
                The tracker started over with it@(reset.Cleared > 0
                    ? $" and cleared the {reset.Cleared:N0} item(s) it knew about before the reset"
                    : ""). It now shows only what the logs have shown since: open your new home's
                inventory and gear up, and each item reappears as you move it. The wipe date in Settings
                moves to the day of the reset.
            </p>
            <div class="popup-actions">
                <button type="button" autofocus @onclick="() => DismissReset(reset)">OK</button>
            </div>
        </div>
    </div>
}

@* Before the first background ingest pass finishes, State.Current is still Snapshot.Empty:
   BuiltAt is unset and Health is IngestHealth.Empty, so health.LogDir reads "" and
   health.LogFiles reads 0 — indistinguishable from a real "no logs found in <LogDir>" unless
   we check BuiltAt first. Show a neutral "still working" banner instead; Browse re-renders on
   its own via State.Changed once Rebuild() publishes a real snapshot. *@
@if (State.Current.BuiltAt == DateTimeOffset.MinValue)
{
    <p class="banner banner-info">
        Reading your Star Citizen logs&hellip; this page updates by itself when done.
    </p>
}
@* These are mutually exclusive and each one fully explains why the page below has
   nothing in it, so at most one is shown and it replaces the generic "no locations" message
   further down (see EmptiesExplained). *@
else if (health.LogFiles == 0)
{
    <p class="banner banner-info">
        No Star Citizen logs found in <code>@health.LogDir</code>.
        <a href="settings">Check the log location in Settings</a>.
    </p>
}
else if (health.FilesWithLinesSinceInception == 0 && health.NewestLogLine is null)
{
    @* First among the empty-file cases: with no timestamped line anywhere — a fresh install,
       or the game only just started a new log — neither a wipe date nor 4.9 is to blame. *@
    <p class="banner banner-info">
        Found @health.LogFiles log file(s), but the game has not written anything to them yet.
        This page updates by itself once it does.
    </p>
}
else if (health.FilesWithLinesSinceInception == 0 && health.InceptionDate is not null)
{
    <p class="banner banner-info">
        Found @health.LogFiles log file(s), but none has anything after your wipe date
        (@FormatDate(health.InceptionDate)). Newest log line: @FormatDate(health.NewestLogLine).
        <a href="settings">Clear or move back the wipe date in Settings</a>.
    </p>
}
else if (health.FilesWithLinesSinceInception == 0)
{
    @* No wipe date to blame, and the files do have lines: they predate the 4.9 cutoff. *@
    <p class="banner banner-info">
        Found @health.LogFiles log file(s), but none has a line the tracker can read.
        Logs written before Star Citizen 4.9 are skipped. Newest log line: @FormatDate(health.NewestLogLine).
    </p>
}
else if (health.Moves == 0 && health.InceptionDate is not null)
{
    @* The tracker learns an item only from a line that moves it, so with a recent date this is
       what a full inventory looks like until things start moving. Say so, or it reads as broken. *@
    <p class="banner banner-info">
        Logs since @FormatDate(health.InceptionDate) were read, but no item has moved since then.
        Items that have sat still since your wipe date are unknown to the tracker.
        <a href="settings">Clear the wipe date in Settings</a> to use your whole history.
    </p>
}
else if (health.Moves == 0)
{
    <p class="banner banner-info">
        Your logs were read, but no item movement was found yet.
    </p>
}

@* The station picker and search share one row, the picker first. Search covers every station,
   ship and drop, so the dropdowns do not narrow it; picking a station while searching leaves
   the search to show it. The picker reads as a path, system then station, each part a
   dropdown; Ctrl+K reaches any station in any system in one step. *@
<div class="toolbar">
    @if (_systems.Count > 0)
    {
        <div class="location-path">
            <svg class="picker-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="12" cy="12" r="3.5" />
                <ellipse cx="12" cy="12" rx="10" ry="3.4" transform="rotate(-25 12 12)" />
            </svg>
            <select class="path-select" aria-label="System" @bind="_system" @bind:after="PickSystem">
                @foreach (var system in _systems)
                {
                    <option value="@system">@system</option>
                }
            </select>
            <span class="crumb-sep" aria-hidden="true">›</span>
            <select class="path-select path-station" aria-label="Station" @bind="_placeId" @bind:after="PickPlace">
                @foreach (var place in _placesInSystem)
                {
                    <option value="@place.Id">@place.LabelInSystem@(place.NameConfirmed ? "" : " (unconfirmed)")</option>
                }
            </select>
        </div>
    }

    <div class="picker-field search-field">
        <svg class="picker-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m20 20-4.35-4.35" stroke-linecap="round" />
        </svg>
        <input type="text" placeholder="Search your items…" class="search-input"
               @bind="_query" @bind:event="oninput" />
    </div>
</div>

@* Quick filters for whatever the page is showing: search results, or the level of the station
   being browsed. A category with nothing in it is not offered, except the one already chosen,
   so it can still be turned off. *@
@{ var categoryCounts = CategoryCounts(); }
@if (categoryCounts.Count > 0 || _category is not null)
{
    <div class="chips" role="group" aria-label="Filter by category">
        <button type="button" class="chip @(_category is null ? "active" : "")" aria-pressed="@(_category is null)"
                @onclick="() => _category = null">All</button>
        @foreach (var category in ItemCategories.All)
        {
            var count = categoryCounts.GetValueOrDefault(category);
            if (count == 0 && _category != category) continue;
            <button type="button" class="chip @(_category == category ? "active" : "")" aria-pressed="@(_category == category)"
                    @onclick="() => _category = _category == category ? null : category">
                @ItemCategories.Label(category) <span class="chip-count">@count</span>
            </button>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(_query))
{
    <section class="place">
        @{ var results = SearchResults(); }
        <h2>Search results <span class="badge-count">@results.Count</span></h2>
        @if (results.Count == 0)
        {
            <p class="empty">None of your items matches "@_query"@(_category is { } c ? $" in {ItemCategories.Label(c)}" : "").</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Where</th>
                        <th>Last moved</th>
                        <th>Confidence</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var h in results)
                {
                    <tr>
                        <td>
                            @if (h.Holding.Geid is { } geid)
                            {
                                <a href="item/@geid">@h.Display</a>
                            }
                            else
                            {
                                @h.Display
                            }
                        </td>
                        <td class="qty">@h.Holding.Quantity&times;</td>
                        <td class="chain">@h.Holding.Where</td>
                        <td class="when" title="@h.Holding.LastMove.ToString("u")">@TimeAgo.Format(h.Holding.LastMove)</td>
                        <td>
                            <span class="conf conf-@h.Holding.Confidence.ToString().ToLowerInvariant()"
                                  title="@string.Join("; ", h.Holding.Caveats)">
                                @h.Holding.Confidence
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
}
else
{
    @if (_systems.Count > 0)
    {
        @if (_place is not null)
        {
            @* A name is only shown as fact once confirmed: by two sources agreeing, or by the
               player here. Until then it says what it is and offers to settle it. *@
            @* Kept open while the player is typing, even if a pass confirms the name meanwhile:
               a correction is never dropped from under them. *@
            @if (!_place.NameConfirmed || _correcting)
            {
                var pending = _place.NameStatus == PlaceNameStatus.Pending;
                <div class="place-status">
                    @if (_place.NameConfirmed)
                    {
                        <span>Rename <strong>@_place.Name</strong>:</span>
                    }
                    else
                    {
                        <span class="badge-unconfirmed">@(pending ? "unconfirmed" : "unresolved")</span>
                        @if (pending)
                        {
                            <span>Named by @SourcesText(_place.NameSources) only. Is this what the game calls it?</span>
                        }
                        else if (_place.RawName is { } raw)
                        {
                            <span>The game only logged this place as <code>@raw</code>.</span>
                        }
                        else
                        {
                            <span>Nothing in the logs names this place.</span>
                        }
                    }

                    @if (_correcting)
                    {
                        <input class="place-input" list="place-suggestions" placeholder="Name as shown in game"
                               @bind="_correction" @bind:event="oninput" />
                        <datalist id="place-suggestions">
                            @foreach (var suggestion in _suggestions)
                            {
                                <option value="@suggestion"></option>
                            }
                        </datalist>
                        <button type="button" @onclick="SaveCorrection" disabled="@string.IsNullOrWhiteSpace(_correction)">Save</button>
                        <button type="button" class="link-btn" @onclick="() => _correcting = false">Cancel</button>
                    }
                    else
                    {
                        @if (pending)
                        {
                            <button type="button" @onclick="ConfirmName">Confirm</button>
                        }
                        <button type="button" @onclick="StartCorrection">@(pending ? "Correct…" : "Name it…")</button>
                    }
                </div>
            }

            @* Only shown once inside a container: the station itself is already named by the
               picker above. Every crumb but the last leads back out to that level. *@
            @if (_path.Count > 0)
            {
                <div class="crumbs">
                    <button type="button" class="link-btn" @onclick="() => LeaveTo(0)">@_place.Label</button>
                    @for (var i = 0; i < _path.Count; i++)
                    {
                        var depth = i + 1;
                        <span class="crumb-sep">›</span>
                        @if (depth == _path.Count)
                        {
                            <span>@_path[i].Label</span>
                        }
                        else
                        {
                            <button type="button" class="link-btn" @onclick="() => LeaveTo(depth)">@_path[i].Label</button>
                        }
                    }
                </div>
            }

            var shown = _direct.Where(r => _category is not { } c || r.Categories.Contains(c)).ToList();
            <section class="place">
                <h2>Local Inventory <span class="badge-count">@shown.Sum(r => r.Quantity)</span></h2>
                @if (_direct.Count == 0)
                {
                    <p class="empty">Nothing tracked here.</p>
                }
                else if (shown.Count == 0)
                {
                    <p class="empty">Nothing in @ItemCategories.Label(_category!.Value) here.</p>
                }
                else
                {
                    @ItemTable(shown)
                }
            </section>
        }
    }

    @* The station view is about what the player stored at stations: equipped/carried/dropped/
       unplaced holdings (anything not ItemHolding.IsAtStation) are deliberately not listed here.
       Search also finds what is in ships and dropped, never what is on the character. *@
    @if (_systems.Count == 0 && !EmptinessExplained(State.Current))
    {
        @* With no station listed, anything tracked at all is somewhere this page does not show;
           saying nothing is tracked would read as the tracker not working. *@
        @if (State.Current.Holdings.Count > 0)
        {
            <p class="empty">Nothing stored at a station yet. Items on your character are not listed here.</p>
        }
        else
        {
            <p class="empty">No locations tracked yet. The tracker reads Star Citizen's logs as you play.</p>
        }
    }
}

@code {
    /// <summary>
    /// One line of the table: every unit of an item class believed to be in one holding.
    /// Identical items are pooled because that is the only level the logs support — a move
    /// of "a magazine" out of a stack of twenty never says which one.
    /// </summary>
    private sealed record Row(
        string Display,
        string ItemClass,
        int Quantity,
        DateTimeOffset LastMove,
        Confidence Confidence,
        bool Unnamed,
        IReadOnlyList<string> Caveats,
        IReadOnlySet<ItemCategory> Categories,
        ContainerRow? Opens = null);

    /// <summary>
    /// Something at the level being browsed that can be opened: a container, or an item with
    /// parts on it. Key is its geid, as it appears in the chain of everything inside it;
    /// Quantity counts everything inside, at any depth.
    /// </summary>
    private sealed record ContainerRow(string Key, string Label, int Quantity);

    private List<string> _systems = [];
    private Dictionary<string, List<Place>> _bySystem = [];
    private List<Place> _placesInSystem = [];

    private string? _system;
    private string? _placeId;
    private Place? _place;

    private List<Row> _direct = [];

    /// <summary>Units of each category at the level being browsed, at any depth below it.</summary>
    private Dictionary<ItemCategory, int> _levelCounts = [];

    /// <summary>The quick filter chosen, or null for everything. Kept when the station changes.</summary>
    private ItemCategory? _category;

    /// <summary>The containers entered at the selected station, outermost first.</summary>
    private List<ContainerRow> _path = [];

    /// <summary>The station _path was built at, so choosing another one starts back at its top.</summary>
    private string? _pathPlaceId;

    private string _query = "";

    /// <summary>True while the player is typing a name for the selected place.</summary>
    private bool _correcting;
    private string _correction = "";
    private IReadOnlyList<string> _suggestions = [];

    /// <summary>Any id of the place to open, so a particular station can be linked to.</summary>
    [SupplyParameterFromQuery(Name = "at")] private string? At { get; set; }

    /// <summary>A search to run on arrival: the command palette's "search your items".</summary>
    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }

    /// <summary>The ?at= and ?q= last acted on. The command palette navigates here while the
    /// page is already open, which sets new parameters without initialising the page again;
    /// only a value that changed is applied, so a re-render never undoes a pick made since.</summary>
    private string? _appliedAt;
    private string? _appliedQ;

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        RefreshOptions();
    }

    protected override void OnParametersSet()
    {
        if (At != _appliedAt)
        {
            _appliedAt = At;
            if (At is not null && State.Current.Resolver?.Places.ByLocationId(At) is { } requested)
            {
                // Again, so a deep-linked station holding nothing is in the picker to select.
                RefreshOptions();
                _system = requested.System;
                _placeId = requested.Id;
                _query = "";
                OnSystemChanged();
            }
        }

        if (Q != _appliedQ)
        {
            _appliedQ = Q;
            if (!string.IsNullOrWhiteSpace(Q)) _query = Q;
        }
    }

    private void RefreshOptions()
    {
        var snapshot = State.Current;
        var catalogue = snapshot.Resolver?.Places;

        if (catalogue is null)
        {
            _systems = [];
            _bySystem = [];
            _placesInSystem = [];
            _system = null;
            _placeId = null;
            _place = null;
            return;
        }

        // A deep link (?at=) must resolve even to a place currently holding nothing, or it
        // gets silently dropped from the very picker it needs to appear in.
        var deepLinked = At is not null ? catalogue.ByLocationId(At) : null;

        _bySystem = StationList.Holding(snapshot, deepLinked)
            .GroupBy(p => p.System, StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                g => g.Key,
                g => g.OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase).ToList(),
                StringComparer.OrdinalIgnoreCase);

        _systems = _bySystem.Keys.ToList();

        if (_system is null || !_bySystem.ContainsKey(_system))
        {
            _system = _systems.FirstOrDefault();
        }

        OnSystemChanged();
    }

    private void OnSystemChanged()
    {
        _placesInSystem = _system is not null && _bySystem.TryGetValue(_system, out var places)
            ? places
            : [];

        if (_placeId is null || _placesInSystem.All(p => p.Id != _placeId))
        {
            _placeId = _placesInSystem.FirstOrDefault()?.Id;
        }

        Recompute();
    }

    /// <summary>The player chose a system or a station: they want to browse it, so a search
    /// still on screen gives way to it.</summary>
    private void PickSystem()
    {
        _query = "";
        OnSystemChanged();
    }

    private void PickPlace()
    {
        _query = "";
        Recompute();
    }

    private void Recompute()
    {
        _place = _placesInSystem.FirstOrDefault(p => p.Id == _placeId);

        if (_place?.Id != _pathPlaceId)
        {
            _path = [];
            _pathPlaceId = _place?.Id;
            _correcting = false;
        }

        if (_place is null)
        {
            _direct = [];
            _levelCounts = [];
            return;
        }

        // The game re-issues a station's id from time to time, so every alias counts as here.
        var aliases = _place.AliasIds.ToHashSet(StringComparer.Ordinal);

        // Chain runs from the item's immediate holder out to the station; the station dropped
        // and the rest reversed, it reads as the containers to open, outermost first.
        var here = State.Current.Holdings
            .Where(h => h.Holding.IsAtStation && aliases.Contains(h.Holding.Root!.Key))
            .Select(h => (Holding: h, Inside: h.Holding.Chain.Take(h.Holding.Chain.Count - 1).Reverse().ToList()))
            .ToList();

        // A refresh can empty or move a container that is open: back out to the deepest level
        // that still holds something rather than show a container that is no longer there.
        while (_path.Count > 0 && !here.Any(h => IsWithin(h.Inside, _path)))
        {
            _path.RemoveAt(_path.Count - 1);
        }

        // A name can resolve while its container is open, so the crumbs are named afresh each
        // time, the same way the row that was clicked would be named now.
        for (var i = 0; i < _path.Count; i++)
        {
            var key = _path[i].Key;
            var outer = _path.Take(i).ToList();
            var own = here.FirstOrDefault(h => h.Inside.Count == i && h.Holding.Holding.Geid == key && IsWithin(h.Inside, outer));
            var label = own.Holding?.Display
                        ?? here.First(h => h.Inside.Count > i && h.Inside[i].Key == key && IsWithin(h.Inside, outer)).Inside[i].Label;
            _path[i] = _path[i] with { Label = label };
        }

        var level = here.Where(h => IsWithin(h.Inside, _path)).ToList();
        var depth = _path.Count;

        // A part on an item at this level — a helmet's visor, a rifle's scope — is part of that
        // item, not something of its own kind stored here: a helmet is Armor, never Other
        // because of its visor. Opened, the item lists its parts, and they count again there.
        var resolver = State.Current.Resolver;
        bool IsPartBelow((NamedHolding Holding, List<HoldingLink> Inside) h) =>
            h.Inside.Count > depth && resolver?.HasParts(h.Inside[^1].Key) == true;

        _levelCounts = level
            .Where(h => !IsPartBelow(h))
            .GroupBy(h => h.Holding.Category)
            .ToDictionary(g => g.Key, g => g.Sum(h => h.Holding.Holding.Quantity));

        var atLevel = level.Where(h => h.Inside.Count == depth).Select(h => h.Holding).ToList();
        var byGeid = atLevel
            .Where(h => h.Holding.Geid is not null)
            .DistinctBy(h => h.Holding.Geid)
            .ToDictionary(h => h.Holding.Geid!, StringComparer.Ordinal);

        // Anything something else sits in or on — a box, a crate, a weapon with its scope, a
        // helmet with its visor — is one row of its own, opening onto what it holds. Pooling
        // two rifles would leave one link for two different sets of attachments.
        var openable = level
            .Where(h => h.Inside.Count > depth)
            .GroupBy(h => h.Inside[depth].Key, StringComparer.Ordinal)
            .Select(g =>
            {
                var inside = g.Select(h => h.Holding).ToList();
                var opens = new ContainerRow(
                    g.Key,
                    byGeid.GetValueOrDefault(g.Key)?.Display ?? g.First().Inside[depth].Label,
                    inside.Sum(h => h.Holding.Quantity));

                // A filter keeps it when it, or anything stored in it, is of the chosen category:
                // the matching items are found by opening it. Parts do not count (see above).
                var categories = g.Where(h => !IsPartBelow(h)).Select(h => h.Holding.Category).ToHashSet();

                // Its own record names it better than its class. Without one — a box set down
                // rather than stored has no move of its own — it is only known through what it
                // holds, so it is dated and trusted by that.
                if (byGeid.TryGetValue(g.Key, out var own)) categories.Add(own.Category);

                // An item known only through its parts has nothing else to go by.
                if (categories.Count == 0) categories = inside.Select(h => h.Category).ToHashSet();
                return own is not null
                    ? Pool([own])[0] with { Opens = opens, Categories = categories }
                    : new Row(
                        opens.Label,
                        opens.Label,
                        1,
                        inside.Max(h => h.Holding.LastMove),
                        inside.Min(h => h.Holding.Confidence),
                        false,
                        inside.SelectMany(h => h.Holding.Caveats).Distinct().ToList(),
                        categories,
                        opens);
            })
            .ToList();

        var openableKeys = openable.Select(r => r.Opens!.Key).ToHashSet(StringComparer.Ordinal);
        var loose = atLevel.Where(h => h.Holding.Geid is not { } geid || !openableKeys.Contains(geid));

        _direct = Pool(loose)
            .Concat(openable)
            .OrderBy(r => r.Display, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>True when every container of <paramref name="path"/> is opened, in order, on the
    /// way to the item.</summary>
    private static bool IsWithin(List<HoldingLink> inside, List<ContainerRow> path) =>
        inside.Count >= path.Count
        && path.Select((c, i) => inside[i].Key == c.Key).All(match => match);

    private void StartCorrection()
    {
        if (_place is null) return;

        _correction = _place.NameStatus == PlaceNameStatus.Unresolved ? "" : _place.Name;
        _suggestions = Places.Suggestions(_place.System);
        _correcting = true;
    }

    private Task ConfirmName() => Decide(_place?.Name);

    private Task SaveCorrection() => Decide(_correction);

    /// <summary>Files the player's word on the name; the rebuild that follows re-renders the
    /// page through <see cref="OnChanged"/>.</summary>
    private async Task Decide(string? name)
    {
        if (_place is not { } place || string.IsNullOrWhiteSpace(name)) return;

        Places.Confirm(place, name);
        _correcting = false;
        await Task.Run(State.Rebuild);
    }

    private static string SourcesText(PlaceNameSource sources)
    {
        var named = new List<string>();
        if (sources.HasFlag(PlaceNameSource.Log)) named.Add("the logs");
        if (sources.HasFlag(PlaceNameSource.GameText)) named.Add("the game's text");
        if (sources.HasFlag(PlaceNameSource.KnownPlaces)) named.Add("the built-in list");
        if (sources.HasFlag(PlaceNameSource.Wiki)) named.Add("the wiki");
        return named.Count == 0 ? "nothing" : string.Join(" and ", named);
    }

    private void Enter(ContainerRow container)
    {
        _path = [.. _path, container];
        Recompute();
    }

    /// <summary>Backs out to <paramref name="depth"/> containers deep; 0 is the station itself.</summary>
    private void LeaveTo(int depth)
    {
        _path = _path.Take(depth).ToList();
        Recompute();
    }

    /// <summary>
    /// Collapses identical items into one line. Confidence takes the least confident row —
    /// a pool is only as trustworthy as its weakest member — and the timestamp the most
    /// recent, which is what the user is actually asking about.
    /// </summary>
    private static List<Row> Pool(IEnumerable<NamedHolding> holdings) =>
        holdings
            .GroupBy(h => h.ClassName, StringComparer.Ordinal)
            .Select(g => new Row(
                g.First().Display,
                g.Key,
                g.Sum(h => h.Holding.Quantity),
                g.Max(h => h.Holding.LastMove),
                g.Min(h => h.Holding.Confidence),
                g.First().Name.Match == NameMatch.None,
                g.SelectMany(h => h.Holding.Caveats).Distinct().ToList(),
                new HashSet<ItemCategory> { g.First().Category }))
            .OrderBy(r => r.Display, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private RenderFragment ItemTable(IReadOnlyList<Row> rows) => @<table>
        <thead>
            <tr>
                <th>Item</th>
                <th>Qty</th>
                <th>Last moved</th>
                <th>Confidence</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in rows)
        {
            <tr>
                <td>
                    @* Items are not links: in the station view only what can be opened leads
                       anywhere, onto what it holds. Search still links to a single item's page. *@
                    @if (row.Opens is { } opens)
                    {
                        <button type="button" class="link-btn" @onclick="() => Enter(opens)">@row.Display</button>
                        <span class="badge-count" title="Items inside, at any depth">@opens.Quantity</span>
                    }
                    else
                    {
                        @row.Display
                    }
                    @if (row.Unnamed)
                    {
                        <span class="unnamed" title="Not found in the wiki catalogue">?</span>
                    }
                </td>
                <td class="qty">@row.Quantity&times;</td>
                <td class="when" title="@row.LastMove.ToString("u")">@TimeAgo.Format(row.LastMove)</td>
                <td>
                    <span class="conf conf-@row.Confidence.ToString().ToLowerInvariant()"
                          title="@string.Join("; ", row.Caveats)">
                        @row.Confidence
                    </span>
                </td>
            </tr>
        }
        </tbody>
    </table>;

    /// <summary>
    /// Every holding stored at a station, in a ship's locker or dropped in the world, at any
    /// depth, whose display name or item class contains the query and whose category passes the
    /// filter. It covers what the station view, the Ships page and the Dropped page cover and
    /// nothing more: what is on the character is never listed. Unpooled — search exists precisely to
    /// find one named instance out of a pool, so collapsing rows here would defeat the point
    /// (unlike the station tables, which pool because the game itself never distinguishes the
    /// pooled units).
    /// </summary>
    private List<NamedHolding> SearchResults() =>
        SearchMatches()
            .Where(h => _category is not { } c || h.Category == c)
            .OrderBy(h => h.Display, StringComparer.OrdinalIgnoreCase)
            .ThenByDescending(h => h.Holding.LastMove)
            .ToList();

    /// <summary>What the query matches, before the category filter.</summary>
    private IEnumerable<NamedHolding> SearchMatches() =>
        State.Current.Holdings
            .Where(h => h.Holding.IsAtStation || h.Holding.IsInShip || h.Holding.IsDropped)
            .Where(h => h.Display.Contains(_query, StringComparison.OrdinalIgnoreCase)
                     || h.ClassName.Contains(_query, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// How much of each category the page could show: search results (as rows, like the
    /// results count) while searching, otherwise units at the level being browsed (like the
    /// Local Inventory count).
    /// </summary>
    private Dictionary<ItemCategory, int> CategoryCounts() =>
        string.IsNullOrWhiteSpace(_query)
            ? _levelCounts
            : SearchMatches().GroupBy(h => h.Category).ToDictionary(g => g.Key, g => g.Count());

    /// <summary>True when the not-yet-built banner or one of the three IngestHealth banners
    /// above already accounts for an empty page — used to suppress the generic "no locations
    /// tracked yet" message so the page never shows two different explanations for the same
    /// emptiness.</summary>
    private static bool EmptinessExplained(TrackerState.Snapshot snapshot) =>
        snapshot.BuiltAt == DateTimeOffset.MinValue
        || snapshot.Health.LogFiles == 0
        || snapshot.Health.FilesWithLinesSinceInception == 0
        || snapshot.Health.Moves == 0;

    /// <summary>
    /// How long after a character reset its popup can still appear. A fresh install reading
    /// months of history should not open on a reset from two patches ago.
    /// </summary>
    private static readonly TimeSpan ResetNoticeFor = TimeSpan.FromDays(30);

    /// <summary>The newest character reset, while it is still news and the user has not closed it.</summary>
    private CharacterResetReport? UnreadReset() =>
        State.Current.Resolver?.CharacterResets.FirstOrDefault() is { } reset
        && DateTimeOffset.UtcNow - reset.ResetAt < ResetNoticeFor
        && !Options.HasDismissedReset(reset.ResetAt)
            ? reset
            : null;

    private async Task DismissReset(CharacterResetReport reset)
    {
        try
        {
            await Options.DismissResetNoticeAsync(reset.ResetAt);
        }
        catch (Exception ex) when (FormOperationErrors.TryGetMessage(ex, out _))
        {
            // The popup is already closed for this run; it comes back on the next launch only
            // if config.json could not be written.
        }
    }

    private Task CloseResetOnEscape(KeyboardEventArgs e, CharacterResetReport reset) =>
        e.Key == "Escape" ? DismissReset(reset) : Task.CompletedTask;

    /// <summary>Calendar-day formatting for the health banners; "-" stands in for a date that
    /// was never set (no wipe date) or never seen (no log line read yet).</summary>
    private static string FormatDate(DateTimeOffset? when) => when?.ToString("yyyy-MM-dd") ?? "-";

    private void OnChanged() => InvokeAsync(() => { RefreshOptions(); StateHasChanged(); });

    public void Dispose() => State.Changed -= OnChanged;
}
