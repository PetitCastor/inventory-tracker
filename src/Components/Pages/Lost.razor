@page "/lost"
@rendermode InteractiveServer
@implements IDisposable
@inject TrackerState State

<PageTitle>Lost at death — Star Citizen inventory</PageTitle>

<h1>Lost at death <span class="badge-count">@_groups.Sum(g => g.Rows.Sum(r => r.Quantity))</span></h1>

@* The game lists what hung on the body when the player died, never what was inside a backpack
   or armour. Those contents are what the tracker last saw go in, so they are as good as the
   moves that put them there. *@
<p class="subtle">What you had on you when you died, including what was in your backpack and armour. Items stay here until you loot them back. The game removes your body after a while and does not log when.</p>

@if (_groups.Count == 0)
{
    <p class="empty">Nothing lost. When you die and leave a body, what was on it is listed here.</p>
}
else
{
    @foreach (var group in _groups)
    {
        <section class="place">
            <h2>@group.Label <span class="badge-count">@group.Rows.Sum(r => r.Quantity)</span></h2>
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Confidence</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in group.Rows)
                {
                    <tr>
                        <td>
                            @if (row.Geid is { } geid)
                            {
                                <a href="item/@geid">@row.Display</a>
                            }
                            else
                            {
                                @row.Display
                            }
                        </td>
                        <td class="qty">@row.Quantity&times;</td>
                        <td>
                            <span class="conf conf-@row.Confidence.ToString().ToLowerInvariant()"
                                  title="@string.Join("; ", row.Caveats)">
                                @row.Confidence
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    }
}

@code {
    /// <summary>What one death left on the body.</summary>
    private sealed record Group(string Label, DateTimeOffset Died, IReadOnlyList<Row> Rows);

    /// <summary>
    /// Every unit of one item class left on one body: eight magazines are one line of 8, as in
    /// a station's table. Only a line that is a single named item links to it.
    /// </summary>
    private sealed record Row(string Display, string? Geid, int Quantity, Confidence Confidence, IReadOnlyList<string> Caveats);

    /// <summary>
    /// Pools identical items. Confidence is the least confident unit's: a line is only as
    /// trustworthy as its weakest member. An item with parts is a line of its own, linking to
    /// the page that lists them: pooling two rifles would leave no link to either's attachments.
    /// </summary>
    private static List<Row> Pool(IEnumerable<NamedHolding> holdings, HoldingResolver? resolver) =>
        holdings
            .GroupBy(h => resolver?.HasParts(h.Holding) == true ? h.Holding.Geid! : h.ClassName, StringComparer.Ordinal)
            .Select(g =>
            {
                var items = g.ToList();
                var quantity = items.Sum(h => h.Holding.Quantity);
                return new Row(
                    items[0].Display,
                    quantity == 1 ? items[0].Holding.Geid : null,
                    quantity,
                    items.Min(h => h.Holding.Confidence),
                    items.SelectMany(h => h.Holding.Caveats).Distinct().ToList());
            })
            .OrderBy(r => r.Display, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private List<Group> _groups = [];

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Load();
    }

    /// <summary>
    /// One section per death, newest first, identical items pooled, in name order. A scope or
    /// a magazine on a rifle is listed on the rifle's page, not here.
    /// </summary>
    private void Load()
    {
        var resolver = State.Current.Resolver;

        _groups = State.Current.Holdings
            .Where(h => h.Holding.IsLostAtDeath && resolver?.IsPart(h.Holding) != true)
            .GroupBy(h => h.Holding.Root!.Key)
            .Select(g =>
            {
                CorpseKey.TryParse(g.Key, out var died, out var locationId);
                var where = locationId.Length == 0 || resolver is null ? "an unknown place" : resolver.PlaceLabel(locationId);
                return new Group(
                    $"Died at {where} · {died:yyyy-MM-dd HH:mm} UTC",
                    died,
                    Pool(g, resolver));
            })
            .OrderByDescending(g => g.Died)
            .ToList();
    }

    private void OnChanged() => InvokeAsync(() => { Load(); StateHasChanged(); });

    public void Dispose() => State.Changed -= OnChanged;
}
