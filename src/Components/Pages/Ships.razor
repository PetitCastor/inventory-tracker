@page "/ships"
@rendermode InteractiveServer
@implements IDisposable
@inject TrackerState State

<PageTitle>Ships — Star Citizen inventory</PageTitle>

<h1>Ships <span class="badge-count">@_ships.Count</span></h1>

@* What is in each ship's lockers. A locker is followed like any container, but it belongs to
   the ship: storing the ship and calling it back out kept the locker and its contents. *@
@if (_ships.Count == 0 && _history.Count == 0)
{
    <p class="empty">Nothing tracked in a ship. Items you put in a ship's lockers are listed here.</p>
}
else
{
    @foreach (var ship in _ships)
    {
        @ShipSection(ship)
    }

    @if (_history.Count > 0)
    {
        @* A ship of the same class came out later under a new geid: this one was claimed or
           destroyed, and its lockers went with it. Kept as a record of what was last in them. *@
        <h2>History</h2>
        <p class="subtle">Ships replaced by a newer one of the same class, after a claim or a loss. What was in their lockers is gone; this is what was last seen there.</p>
        @foreach (var ship in _history)
        {
            @ShipSection(ship)
        }
    }
}

@code {
    /// <summary>One ship and what its lockers hold, most recently moved first.</summary>
    private sealed record Ship(string Label, ShipRetrieval? Retrieved, DateTimeOffset? Replaced, IReadOnlyList<NamedHolding> Items);

    private List<Ship> _ships = [];

    /// <summary>Ships a newer one of their class replaced, most recently seen first.</summary>
    private List<Ship> _history = [];

    private RenderFragment ShipSection(Ship ship) => __builder =>
    {
        <section class="place">
            <h2>@ship.Label <span class="badge-count">@ship.Items.Sum(i => i.Holding.Quantity)</span></h2>
            @if (ship.Replaced is { } lastSeen)
            {
                <p class="subtle">Replaced — last seen @lastSeen.ToString("yyyy-MM-dd HH:mm") UTC</p>
            }
            else if (ship.Retrieved is { } retrieved)
            {
                <p class="subtle">
                    Last retrieved @(retrieved.PlaceLabel is { } at ? $"at {at}, " : "")@retrieved.At.ToString("yyyy-MM-dd HH:mm") UTC
                </p>
            }
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Qty</th>
                        <th>Last moved (UTC)</th>
                        <th>Confidence</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in ship.Items)
                {
                    <tr>
                        <td>
                            @if (item.Holding.Geid is { } geid)
                            {
                                <a href="item/@geid">@item.Display</a>
                            }
                            else
                            {
                                @item.Display
                            }
                        </td>
                        <td class="qty">@item.Holding.Quantity&times;</td>
                        <td class="when">@item.Holding.LastMove.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <span class="conf conf-@item.Holding.Confidence.ToString().ToLowerInvariant()"
                                  title="@string.Join("; ", item.Holding.Caveats)">
                                @item.Holding.Confidence
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    };

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Load();
    }

    /// <summary>
    /// Groups by ship: by geid when a locker's own geid ties it to one, else by the class the
    /// locker names. A ship a newer one of its class replaced goes to the history.
    /// </summary>
    private void Load()
    {
        var snapshot = State.Current;
        var resolver = snapshot.Resolver;

        var ships = snapshot.Holdings
            .Where(h => h.Holding.IsInShip)
            .GroupBy(h => h.Holding.Root!.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => new Ship(
                resolver?.ShipLabel(g.Key) ?? g.Key,
                resolver?.LastRetrieved(g.Key),
                resolver?.IsShipReplaced(g.Key) == true
                    ? resolver.ShipLastSeen(g.Key) ?? g.Max(h => h.Holding.LastMove)
                    : null,
                g.OrderByDescending(h => h.Holding.LastMove).ToList()))
            .ToList();

        _ships = ships
            .Where(s => s.Replaced is null)
            .OrderBy(s => s.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _history = ships
            .Where(s => s.Replaced is not null)
            .OrderByDescending(s => s.Replaced)
            .ToList();
    }

    private void OnChanged() => InvokeAsync(() => { Load(); StateHasChanged(); });

    public void Dispose() => State.Changed -= OnChanged;
}
