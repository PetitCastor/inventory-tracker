@page "/settings"
@rendermode InteractiveServer
@implements IDisposable
@using InventoryTracker.App
@using InventoryTracker.Ingest
@inject TrackerState State
@inject TrackerOptions Options
@inject LogWatchService Watcher
@inject InventoryTracker.App.DesktopShell Shell
@inject UpdateService Updates

<PageTitle>Settings — Star Citizen inventory</PageTitle>

<h1>Settings</h1>

<h2>Log source</h2>
<div class="settings-field">
    <label for="log-dir">Game.log location</label>
    <div class="input-row">
        <input id="log-dir" type="text" @bind="_logDir" placeholder="C:\Program Files\Roberts Space Industries\StarCitizen\LIVE" />
        <button type="button" class="icon-btn" title="Browse for folder" @onclick="BrowseFolder">
            <svg class="picker-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v1H3z" />
                <path d="M3 10h18l-2 8a2 2 0 0 1-2 1.5H5a2 2 0 0 1-2-1.5z" />
            </svg>
        </button>
    </div>
</div>

<div class="settings-field">
    <label for="inception">Inception date</label>
    <input id="inception" type="date" @bind="_inceptionDate" />
</div>
<p class="subtle">Everything logged before this date is ignored. Only applies to newly-ingested log lines — use "Save and rebuild" below to apply it to history already stored.</p>

<div class="settings-actions">
    <button @onclick="SaveAndRebuild" disabled="@_rebuilding">Save and rebuild from logs</button>
    @if (_rebuilding)
    {
        <span class="rebuild-status"><span class="spinner"></span> Rebuilding…</span>
    }
    else if (_rebuilt)
    {
        <span class="rebuild-status done">
            <svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5" />
            </svg>
        </span>
    }
</div>

<dl class="facts">
    <dt>Log directory</dt><dd><code>@Options.LogDir</code></dd>
    <dt>Tracked instances</dt><dd>@_holdings.Count</dd>
    <dt>Recorded moves</dt><dd>@(State.Current.Resolver?.Moves.Count ?? 0)</dd>
    <dt>Snapshot built</dt><dd>@State.Current.BuiltAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>
    <dt>Item catalogue</dt>
    <dd>@(_catalogueAge is null ? "never downloaded" : $"refreshed {_catalogueAge:yyyy-MM-dd}")</dd>
</dl>

<div class="settings-actions">
    <button @onclick="RefreshNames" disabled="@_refreshingNames">Refresh item names from wiki</button>
    @if (_refreshingNames)
    {
        <span class="rebuild-status"><span class="spinner"></span> @(_namesProgress ?? "starting…")</span>
    }
    else if (_namesError is { } err)
    {
        <span class="rebuild-status error">@err</span>
    }
    else if (_namesRefreshed)
    {
        <span class="rebuild-status done">
            <svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5" />
            </svg>
        </span>
    }
</div>

<h2>Updates</h2>
<div class="settings-actions">
    <button @onclick="CheckForUpdate" disabled="@(_checkingUpdate || _downloadingUpdate)">Check for updates</button>
    @if (_checkingUpdate)
    {
        <span class="rebuild-status"><span class="spinner"></span> Checking…</span>
    }
    else if (_downloadingUpdate)
    {
        <span class="rebuild-status"><span class="spinner"></span> @(_updateStatus ?? $"Downloading… {(int)_updateProgress}%")</span>
    }
    else if (_updateError is { } uerr)
    {
        <span class="rebuild-status error">@uerr</span>
    }
    else if (_updateStatus is { } ustatus)
    {
        <span class="rebuild-status done">@ustatus</span>
    }
</div>
<p class="subtle">Running v@(_currentVersion).</p>

<h2>Confidence spread</h2>
<ul>
    @foreach (var group in _holdings.GroupBy(h => h.Holding.Confidence).OrderByDescending(g => g.Key))
    {
        <li>@group.Key: @group.Count()</li>
    }
</ul>

@* Each of these is a place the heuristics fell short — they explain any Low scores. *@
<h2>Unnamed stations (@_unnamedLocations.Count)</h2>
<p class="subtle">Location ids the log never paired with a name, so items there show only a number.</p>
<ul>
    @foreach (var (id, count) in _unnamedLocations)
    {
        <li><code>@id</code> — @count item(s)</li>
    }
</ul>

<h2>Unidentified containers (@_unknownContainers.Count)</h2>
<p class="subtle">Containers we saw items go into but never saw opened, so we cannot say what or where they are.</p>
<ul>
    @foreach (var key in _unknownContainers)
    {
        <li><code>@key</code></li>
    }
</ul>

<h2>Items with no wiki name (@_unnamedItems.Count)</h2>
<ul>
    @foreach (var cls in _unnamedItems)
    {
        <li><code>@cls</code></li>
    }
</ul>

@code {
    private IReadOnlyList<NamedHolding> _holdings = [];
    private List<(string Id, int Count)> _unnamedLocations = [];
    private List<string> _unknownContainers = [];
    private List<string> _unnamedItems = [];
    private DateTimeOffset? _catalogueAge;

    private string _logDir = "";
    private DateOnly? _inceptionDate;
    private bool _rebuilding;
    private bool _rebuilt;

    private bool _refreshingNames;
    private bool _namesRefreshed;
    private string? _namesProgress;
    private string? _namesError;

    private readonly string _currentVersion = UpdateService.CurrentVersion.ToString(3);
    private bool _checkingUpdate;
    private bool _downloadingUpdate;
    private double _updateProgress;
    private string? _updateStatus;
    private string? _updateError;

    private async Task BrowseFolder()
    {
        var picked = await Task.Run(() => Shell.PickFolder(_logDir));
        if (picked is not null) _logDir = picked;
    }

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;

        _logDir = Options.LogDir;
        _inceptionDate = Options.InceptionDate is { } d ? DateOnly.FromDateTime(d.UtcDateTime) : null;

        RefreshDiagnostics();
    }

    /// <summary>
    /// Re-derives everything shown from the current snapshot. Called on load, whenever the
    /// tracker publishes a new snapshot, and after a rebuild — the three diagnostic lists
    /// would otherwise keep describing the previous store, headline counts included, with
    /// nothing on screen saying so.
    /// </summary>
    private void RefreshDiagnostics()
    {
        _holdings = State.Current.Holdings;
        _catalogueAge = State.Names.LastRefresh();

        // A link labelled "location <id>" or "container <id>" is the resolver's way of
        // saying it had nothing better than the raw id.
        _unnamedLocations = _holdings
            .Where(h => h.Holding.Root is { Kind: InventoryKind.Location } root
                && root.Label.StartsWith("location ", StringComparison.Ordinal))
            .GroupBy(h => h.Holding.Root!.Key)
            .Select(g => (Id: g.Key, Count: g.Sum(h => h.Holding.Quantity)))
            .OrderByDescending(x => x.Count)
            .ToList();

        _unknownContainers = _holdings
            .SelectMany(h => h.Holding.Chain)
            .Where(l => l.Kind == InventoryKind.Container && l.Label.StartsWith("container ", StringComparison.Ordinal))
            .Select(l => l.Key)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        _unnamedItems = _holdings
            .Where(h => h.Name.Match == NameMatch.None)
            .Select(h => h.ClassName)
            .Distinct()
            .OrderBy(x => x)
            .ToList();
    }

    private void OnChanged() => InvokeAsync(() => { RefreshDiagnostics(); StateHasChanged(); });

    public void Dispose() => State.Changed -= OnChanged;

    /// <summary>
    /// The inception date only gates what gets ingested from here on — it does not remove
    /// rows already in the store. Wiping and re-ingesting is the only way to make an
    /// earlier cutoff apply to history that was captured before it was set.
    /// </summary>
    private async Task SaveAndRebuild()
    {
        _rebuilt = false;
        _rebuilding = true;
        StateHasChanged();

        try
        {
            await Options.ApplyLogSourceAsync(_logDir, _inceptionDate, Watcher);
            RefreshDiagnostics();
            _rebuilt = true;
        }
        finally
        {
            _rebuilding = false;
        }
    }

    /// <summary>
    /// Web-UI equivalent of the tray menu's "Refresh item names from wiki". Progress is
    /// reported via the page-by-page callback <see cref="WikiNameService.RefreshAsync"/>
    /// already supports; <see cref="Progress{T}"/> captures this circuit's synchronization
    /// context at construction time, so each report marshals back here on its own.
    /// </summary>
    private async Task RefreshNames()
    {
        _namesRefreshed = false;
        _namesError = null;
        _namesProgress = null;
        _refreshingNames = true;
        StateHasChanged();

        var progress = new Progress<string>(p =>
        {
            _namesProgress = p;
            StateHasChanged();
        });

        try
        {
            await State.Names.RefreshAsync(progress);
            State.Rebuild();
            RefreshDiagnostics();
            _namesRefreshed = true;
        }
        catch (Exception ex)
        {
            _namesError = $"Could not download item names: {ex.Message}";
        }
        finally
        {
            _refreshingNames = false;
        }
    }

    /// <summary>
    /// One button drives the whole pipeline: check, and if something newer exists, download
    /// it and restart straight into it. There is no separate confirm step — same behaviour
    /// as the launch-time check in <c>TrayHost</c>, just triggered by hand instead of on
    /// startup.
    /// </summary>
    private async Task CheckForUpdate()
    {
        _updateError = null;
        _updateStatus = null;
        _checkingUpdate = true;
        StateHasChanged();

        UpdateInfo? info;
        try
        {
            info = await Updates.CheckForUpdateAsync();
        }
        catch (Exception ex)
        {
            _updateError = $"Could not check for updates: {ex.Message}";
            _checkingUpdate = false;
            return;
        }

        if (info is null)
        {
            _updateStatus = $"Up to date (v{_currentVersion}).";
            _checkingUpdate = false;
            return;
        }

        _checkingUpdate = false;
        _downloadingUpdate = true;
        _updateProgress = 0;
        StateHasChanged();

        try
        {
            var progress = new Progress<double>(p =>
            {
                _updateProgress = p;
                InvokeAsync(StateHasChanged);
            });

            var path = await Updates.DownloadAsync(info, progress);

            _updateStatus = $"Restarting into {info.TagName}…";
            StateHasChanged();
            await Task.Delay(300);

            // Nothing after this should run: InstallAndRestart hands off to a helper that
            // waits for this process to exit, so exiting now is the handoff.
            UpdateService.InstallAndRestart(path);
            Environment.Exit(0);
        }
        catch (Exception ex)
        {
            _updateError = $"Could not install {info.TagName}: {ex.Message}";
            _downloadingUpdate = false;
        }
    }
}
