@page "/settings"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using InventoryTracker.App
@using InventoryTracker.Ingest
@using InventoryTracker.Naming
@inject TrackerState State
@inject TrackerOptions Options
@inject LogWatchService Watcher
@inject PlaceNameService Places
@inject InventoryTracker.Data.TrackerDb Db
@inject InventoryTracker.App.DesktopShell Shell
@inject UpdateService Updates
@inject Microsoft.Extensions.Hosting.IHostApplicationLifetime Lifetime
@inject WikiRefreshTaskOwner OperationOwner
@inject ReleaseNotesService ReleaseNotes
@inject NavigationManager Nav

<PageTitle>Settings — Star Citizen inventory</PageTitle>

<h1>Settings</h1>

@* Sections are links, not in-page state: a reload or a link from Browse lands on the right one,
   and the router keeps this component alive between them, so a rebuild or download started on
   one section keeps running while another is open. *@
<div class="settings-layout">
    <nav class="settings-nav" aria-label="Settings sections">
        <a href="settings" class="@NavClass(TabLogs)" aria-current="@Current(TabLogs)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            </svg>
            Log source
        </a>
        <a href="settings?tab=@TabNames" class="@NavClass(TabNames)" aria-current="@Current(TabNames)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z" /><path d="M4 21V5" /><path d="M8 7h7" />
            </svg>
            Names
        </a>
        <a href="settings?tab=@TabUpdates" class="@NavClass(TabUpdates)" aria-current="@Current(TabUpdates)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" />
            </svg>
            Updates
        </a>
        <a href="settings?tab=@TabAppearance" class="@NavClass(TabAppearance)" aria-current="@Current(TabAppearance)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" />
            </svg>
            Appearance
        </a>
        <a href="settings?tab=@TabDiagnostics" class="@NavClass(TabDiagnostics)" aria-current="@Current(TabDiagnostics)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 12h4l3-8 4 16 3-8h4" />
            </svg>
            Diagnostics
            @if (HasReadProblem)
            {
                <span class="nav-dot" title="Some log lines were not fully read"></span>
            }
        </a>
    </nav>

    <div class="settings-panel">
        @switch (_tab)
        {
            case TabNames:
                <h2>Names</h2>
                <p class="panel-lead">Item and station names come from the Star Citizen wiki.</p>
                <section class="settings-card">
                    <div class="setting-row">
                        <span class="setting-label">Item catalogue</span>
                        <span class="setting-value">@Age(_catalogueAge)</span>
                    </div>
                    <div class="setting-row">
                        <span class="setting-label">Place list</span>
                        <span class="setting-value">@Age(_placesAge)</span>
                    </div>
                    <div class="settings-card-footer">
                        @if (_refreshingNames)
                        {
                            <span class="rebuild-status"><span class="spinner"></span> @(_namesProgress ?? "starting…")</span>
                        }
                        else if (_namesError is { } err)
                        {
                            <span class="rebuild-status error" role="alert">@err</span>
                        }
                        else if (_namesRefreshed)
                        {
                            <span class="rebuild-status done">Names refreshed.</span>
                        }
                        <button @onclick="RefreshNames" disabled="@_refreshingNames">Refresh from wiki</button>
                    </div>
                </section>
                break;

            case TabUpdates:
                <h2>Updates</h2>
                <section class="settings-card">
                    <div class="setting-row">
                        <div class="setting-text">
                            <span class="setting-label">Version</span>
                            <span class="setting-hint">Installs and restarts if a newer release exists.</span>
                        </div>
                        <div class="setting-control">
                            <span class="setting-value">v@(_currentVersion)</span>
                            <button @onclick="CheckForUpdate" disabled="@(_checkingUpdate || _downloadingUpdate)">Check for updates</button>
                        </div>
                    </div>
                    @if (_checkingUpdate || _downloadingUpdate || _updateError is not null || _updateStatus is not null)
                    {
                        <div class="settings-card-footer">
                            @if (_checkingUpdate)
                            {
                                <span class="rebuild-status"><span class="spinner"></span> Checking…</span>
                            }
                            else if (_downloadingUpdate)
                            {
                                <span class="rebuild-status"><span class="spinner"></span> @(_updateStatus ?? $"Downloading… {(int)_updateProgress}%")</span>
                            }
                            else if (_updateError is { } uerr)
                            {
                                <span class="rebuild-status error" role="alert">@uerr</span>
                            }
                            else if (_updateStatus is { } ustatus)
                            {
                                <span class="rebuild-status done">@ustatus</span>
                            }
                        </div>
                    }
                </section>

                <h2>Recent changes</h2>
                <section class="settings-card">
                    @if (_releaseNotesError is { } nerr)
                    {
                        <p class="subtle">@nerr</p>
                    }
                    else if (_recentReleases is null)
                    {
                        <p class="subtle"><span class="spinner"></span> Loading release notes…</p>
                    }
                    else if (_recentReleases.Count == 0)
                    {
                        <p class="subtle">No release notes yet.</p>
                    }
                    else
                    {
                        <ReleaseNoteList Releases="_recentReleases" />
                    }
                </section>
                break;

            case TabAppearance:
                <h2>Appearance</h2>
                <section class="settings-card">
                    <div class="setting-row">
                        <div class="setting-text">
                            <span class="setting-label">Theme</span>
                            <span class="setting-hint">System follows the Windows light or dark setting.</span>
                        </div>
                    </div>
                    <div class="theme-choices" role="radiogroup" aria-label="Theme">
                        @foreach (var theme in Enum.GetValues<AppTheme>())
                        {
                            <label class="theme-choice">
                                <input type="radio" name="theme" checked="@(Options.Theme == theme)"
                                       disabled="@_savingTheme" @onchange="() => ChangeTheme(theme)" />
                                @theme
                            </label>
                        }
                    </div>
                    @if (_themeError is { } terr)
                    {
                        <div class="settings-card-footer">
                            <span class="rebuild-status error" role="alert">@terr</span>
                        </div>
                    }
                </section>
                break;

            case TabDiagnostics:
                <h2>Diagnostics</h2>
                <h3>Inventory</h3>
                <section class="settings-card">
                    <dl class="facts">
                        <dt>Tracked items</dt><dd>@_holdings.Count.ToString("N0")</dd>
                        <dt>Recorded moves</dt><dd>@((State.Current.Resolver?.Moves.Count ?? 0).ToString("N0"))</dd>
                        <dt>Confidence</dt>
                        <dd class="conf-spread">
                            @foreach (var group in _holdings.GroupBy(h => h.Holding.Confidence).OrderByDescending(g => g.Key))
                            {
                                <span class="conf conf-@(group.Key.ToString().ToLowerInvariant())">@group.Key @group.Count()</span>
                            }
                        </dd>
                        <dt>Snapshot built</dt><dd>@(NotYetBuilt ? "not yet" : $"{State.Current.BuiltAt.ToLocalTime():yyyy-MM-dd HH:mm:ss}")</dd>
                    </dl>
                </section>

                @* The same numbers the Browse page's health banner is derived from. Before the first
                   ingest pass the snapshot is empty and every count reads 0 — not because nothing
                   was found, but because nothing was read — so say that once instead. *@
                <h3>Log reading</h3>
                <section class="settings-card">
                    @if (NotYetBuilt)
                    {
                        <p class="subtle">Logs not read yet.</p>
                    }
                    else
                    {
                        <dl class="facts">
                            <dt>Log files</dt>
                            <dd>@($"{_health.LogFiles} found, {_health.FilesWithLinesSinceInception} with data{(Options.InceptionDate is null ? "" : " since the wipe date")}")</dd>
                            <dt>Not fully read</dt>
                            <dd class="@(HasReadProblem ? "warn" : null)">@_health.IncompleteFiles rotated file(s), @_health.UnrecognisedMoveLines move line(s)</dd>
                            <dt>Newest log line</dt>
                            <dd>@(_health.NewestLogLine is { } newest ? $"{newest.ToLocalTime():yyyy-MM-dd HH:mm:ss}" : "none")</dd>
                            <dt>Last read</dt>
                            <dd>
                                @if (Watcher.LastPass is { } pass)
                                {
                                    @($"{pass.At.ToLocalTime():HH:mm:ss} · {pass.Trigger.ToString().ToLowerInvariant()} · {pass.LinesRead:N0} lines, {pass.MovesInserted} new moves, {pass.Duration.TotalMilliseconds:F0} ms")
                                    @if (pass.Error is { } passError)
                                    {
                                        <span class="rebuild-status error"> failed: @passError</span>
                                    }
                                    @if (pass.Incomplete is { } incomplete)
                                    {
                                        <span class="rebuild-status error"> incomplete, will retry: @incomplete</span>
                                    }
                                }
                                else
                                {
                                    @("not run yet")
                                }
                            </dd>
                            @* When the pass ran, not when the moves happened: a startup or rebuild pass
                               reads old moves too, and the label must not suggest they are recent. *@
                            <dt>Last new moves</dt>
                            <dd>@(Watcher.LastMovesAt is { } movesAt ? movesAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") : "none since launch")</dd>
                            <dt>App log</dt><dd><code class="path">@FileLoggerProvider.DefaultPath</code></dd>
                        </dl>
                    }
                </section>

                @* Each of these is a place the heuristics fell short — they explain any Low scores. *@
                <h3>Gaps</h3>
                <section class="settings-card gaps">
                    <details>
                        <summary>Unnamed stations <span class="badge-count">@_unnamedLocations.Count</span></summary>
                        <p class="setting-hint">Location ids the log never paired with a name.</p>
                        <ul>
                            @foreach (var (id, count) in _unnamedLocations)
                            {
                                <li><code>@id</code> — @count item(s)</li>
                            }
                        </ul>
                    </details>
                    <details>
                        <summary>Unidentified containers <span class="badge-count">@_unknownContainers.Count</span></summary>
                        <p class="setting-hint">Items went in, but the container was never seen opened.</p>
                        <ul>
                            @foreach (var key in _unknownContainers)
                            {
                                <li><code>@key</code></li>
                            }
                        </ul>
                    </details>
                    <details>
                        <summary>Items with no wiki name <span class="badge-count">@_unnamedItems.Count</span></summary>
                        <ul>
                            @foreach (var cls in _unnamedItems)
                            {
                                <li><code>@cls</code></li>
                            }
                        </ul>
                    </details>
                </section>
                break;

            default:
                <h2>Log source</h2>
                <section class="settings-card">
                    <div class="setting-row">
                        <div class="setting-text">
                            <label class="setting-label" for="log-dir">Game.log folder</label>
                            <span class="setting-hint">The LIVE or PTU folder.</span>
                        </div>
                        <div class="setting-control">
                            <input id="log-dir" type="text" @bind="_logDir" placeholder="C:\Program Files\Roberts Space Industries\StarCitizen\LIVE" />
                            <button type="button" class="icon-btn" title="Browse for folder" @onclick="BrowseFolder">
                                <svg class="picker-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 7a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v1H3z" />
                                    <path d="M3 10h18l-2 8a2 2 0 0 1-2 1.5H5a2 2 0 0 1-2-1.5z" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    @* The tracker only knows an item once a log line moves it, so a date also hides
                       everything that has sat still since then. Worth saying where it is chosen. *@
                    <div class="setting-row">
                        <div class="setting-text">
                            <label class="setting-label" for="inception">Wipe date</label>
                            <span class="setting-hint">Everything logged before it is ignored, even items that have not moved since. Moves forward on its own to the day of a character reset. Set it by hand after a persistence wipe; leave it empty to read your whole history.</span>
                        </div>
                        <div class="setting-control">
                            <input id="inception" type="date" class="date-input" @bind="_inceptionDate" />
                            @if (_inceptionDate is not null)
                            {
                                <button type="button" @onclick="() => _inceptionDate = null">Clear</button>
                            }
                        </div>
                    </div>
                    <div class="settings-card-footer">
                        @if (_rebuilding)
                        {
                            <span class="rebuild-status"><span class="spinner"></span> Rebuilding…</span>
                        }
                        else if (_rebuildError is not null)
                        {
                            <span class="rebuild-status error" role="alert">@_rebuildError</span>
                        }
                        else if (_rebuilt)
                        {
                            <span class="rebuild-status done">Saved and rebuilt.</span>
                        }
                        else
                        {
                            <span class="subtle">Saving re-reads every log from scratch.</span>
                        }
                        <button class="primary" @onclick="SaveAndRebuild" disabled="@_rebuilding">Save and rebuild</button>
                    </div>
                </section>
                break;
        }
    </div>
</div>

@code {
    private const string TabLogs = "logs";
    private const string TabNames = "names";
    private const string TabUpdates = "updates";
    private const string TabAppearance = "appearance";
    private const string TabDiagnostics = "diagnostics";

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private string _tab = TabLogs;

    protected override void OnParametersSet() =>
        _tab = Tab?.ToLowerInvariant() switch
        {
            TabNames => TabNames,
            TabUpdates => TabUpdates,
            TabAppearance => TabAppearance,
            TabDiagnostics => TabDiagnostics,
            _ => TabLogs,
        };

    private string NavClass(string tab) => tab == _tab ? "active" : "";

    private string? Current(string tab) => tab == _tab ? "page" : null;

    /// <summary>Before the first ingest pass the snapshot is <c>Snapshot.Empty</c>.</summary>
    private bool NotYetBuilt => State.Current.BuiltAt == DateTimeOffset.MinValue;

    /// <summary>Flags the Diagnostics section in the side nav, so a reader problem is seen
    /// without opening it.</summary>
    private bool HasReadProblem =>
        !NotYetBuilt && (_health.IncompleteFiles > 0 || _health.UnrecognisedMoveLines > 0
            || Watcher.LastPass is { Error: not null } or { Incomplete: not null });

    private static string Age(DateTimeOffset? refreshed) =>
        refreshed is { } at ? $"refreshed {at.ToLocalTime():yyyy-MM-dd}" : "never downloaded";

    private IReadOnlyList<NamedHolding> _holdings = [];
    private IngestHealth _health = IngestHealth.Empty;
    private List<(string Id, int Count)> _unnamedLocations = [];
    private List<string> _unknownContainers = [];
    private List<string> _unnamedItems = [];
    private DateTimeOffset? _catalogueAge;
    private DateTimeOffset? _placesAge;

    private string _logDir = "";
    private DateOnly? _inceptionDate;
    private bool _rebuilding;
    private bool _rebuilt;
    private string? _rebuildError;

    private bool _refreshingNames;
    private bool _namesRefreshed;
    private string? _namesProgress;
    private string? _namesError;
    private readonly CancellationTokenSource _pageStopping = new();
    private bool _disposed;

    private readonly string _currentVersion = UpdateService.CurrentVersion.ToString(3);
    private bool _checkingUpdate;
    private bool _downloadingUpdate;
    private double _updateProgress;
    private string? _updateStatus;
    private string? _updateError;

    /// <summary>Released versions up to the running one with notes to show; null while loading.</summary>
    private IReadOnlyList<ReleaseNote>? _recentReleases;
    private string? _releaseNotesError;

    private bool _savingTheme;
    private string? _themeError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // After the first render, not during it: the notes come from GitHub, and the page must
        // not wait on the network to appear. One shared read serves every section.
        try
        {
            var releases = await ReleaseNotes.GetReleasesAsync();
            _recentReleases = WhatsNewDecision.Select(
                releases, lastSeen: new Version(0, 0, 0, 0), UpdateService.CurrentVersion);
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            _releaseNotesError = "Release notes could not be loaded from GitHub.";
            System.Diagnostics.Trace.WriteLine($"Settings release notes: {ex.Message}");
        }

        if (!_disposed) StateHasChanged();
    }

    /// <summary>
    /// Saves the theme, then reloads the page: the palette hangs off the document's data-theme,
    /// which is rendered once per page load. The app window's title bar follows at once through
    /// <see cref="TrackerOptions.ThemeChanged"/>.
    /// </summary>
    private async Task ChangeTheme(AppTheme theme)
    {
        if (theme == Options.Theme) return;

        _themeError = null;
        _savingTheme = true;
        try
        {
            await Options.SetThemeAsync(theme);
        }
        catch (Exception ex) when (FormOperationErrors.TryGetMessage(ex, out _))
        {
            // Applied for this run already; only remembering it failed.
            _themeError = $"The theme applies until you quit, but could not be saved: {ex.Message}";
        }
        finally
        {
            _savingTheme = false;
        }

        if (_themeError is null) Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private async Task BrowseFolder()
    {
        var picked = await Task.Run(() => Shell.PickFolder(_logDir));
        if (picked is not null) _logDir = picked;
    }

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Watcher.PassCompleted += OnPassCompleted;

        _logDir = Options.LogDir;
        _inceptionDate = Options.InceptionDate is { } d ? DateOnly.FromDateTime(d.UtcDateTime) : null;

        RefreshDiagnostics();
    }

    /// <summary>
    /// Re-derives everything shown from the current snapshot. Called on load, whenever the
    /// tracker publishes a new snapshot, and after a rebuild — the three diagnostic lists
    /// would otherwise keep describing the previous store, headline counts included, with
    /// nothing on screen saying so.
    /// </summary>
    private void RefreshDiagnostics()
    {
        _holdings = State.Current.Holdings;
        LoadHealth();
        _catalogueAge = State.Names.LastRefresh();
        _placesAge = Places.LastRefresh();

        // A link labelled "location <id>" or "container <id>" is the resolver's way of
        // saying it had nothing better than the raw id.
        _unnamedLocations = _holdings
            .Where(h => h.Holding.IsAtStation
                && h.Holding.Root!.Label.StartsWith("location ", StringComparison.Ordinal))
            .GroupBy(h => h.Holding.Root!.Key)
            .Select(g => (Id: g.Key, Count: g.Sum(h => h.Holding.Quantity)))
            .OrderByDescending(x => x.Count)
            .ToList();

        _unknownContainers = _holdings
            .SelectMany(h => h.Holding.Chain)
            .Where(l => l.Kind == InventoryKind.Container && l.Label.StartsWith("container ", StringComparison.Ordinal))
            .Select(l => l.Key)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        _unnamedItems = _holdings
            .Where(h => h.Name.Match == NameMatch.None)
            .Select(h => h.ClassName)
            .Distinct()
            .OrderBy(x => x)
            .ToList();
    }

    private void OnChanged() => InvokeAsync(() => { RefreshDiagnostics(); StateHasChanged(); });

    /// <summary>
    /// Most passes find nothing and publish no snapshot, so the last-read row would otherwise
    /// freeze at the last pass that did. The health rows are re-read here too, from the store
    /// rather than the snapshot: "last read 21:40, 120 lines" next to a newest log line from an
    /// hour ago would look like a stuck reader. One aggregate query; cheap every 2 s.
    /// </summary>
    private void OnPassCompleted() => InvokeAsync(() => { LoadHealth(); StateHasChanged(); });

    private void LoadHealth()
    {
        try
        {
            _health = IngestHealth.Load(Db, Options.LogDir, Options.InceptionDate);
        }
        catch (Exception)
        {
            // A busy or locked store costs this refresh; the snapshot's copy stands in.
            _health = State.Current.Health;
        }
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        _pageStopping.Cancel();
        _pageStopping.Dispose();
        State.Changed -= OnChanged;
        Watcher.PassCompleted -= OnPassCompleted;
        return ValueTask.CompletedTask;
    }

    private Task RunOwnedAsync(Func<CancellationToken, Task> operation) =>
        OperationOwner.RunAsync(async ownerToken =>
        {
            using var linked = CancellationTokenSource.CreateLinkedTokenSource(ownerToken, _pageStopping.Token);
            await operation(linked.Token);
        });

    /// <summary>
    /// The wipe date only gates what gets ingested from here on — it does not remove
    /// rows already in the store. Wiping and re-ingesting is the only way to make a
    /// changed date apply to history that was captured before it was set.
    /// </summary>
    private async Task SaveAndRebuild()
    {
        _rebuilt = false;
        _rebuildError = null;
        _rebuilding = true;
        StateHasChanged();

        try
        {
            await RunOwnedAsync(async ct =>
            {
                await Options.ApplyLogSourceAsync(_logDir, _inceptionDate, Watcher, cancellationToken: ct);
                await InvokeAsync(() =>
                {
                    RefreshDiagnostics();
                    _rebuilt = true;
                    StateHasChanged();
                });
            });
        }
        catch (OperationCanceledException ex) when (OperationOwner.IsStopping || Lifetime.ApplicationStopping.IsCancellationRequested || _pageStopping.IsCancellationRequested)
        {
            System.Diagnostics.Trace.WriteLine($"Settings rebuild canceled during shutdown: {ex.Message}");
        }
        catch (OperationCanceledException ex)
        {
            _rebuildError = $"Rebuild was canceled: {ex.Message}";
        }
        catch (Exception ex) when (FormOperationErrors.TryGetMessage(ex, out _))
        {
            FormOperationErrors.TryGetMessage(ex, out var message);
            _rebuildError = $"Could not save settings and rebuild: {message}";
        }
        finally
        {
            _rebuilding = false;
            if (!_disposed) StateHasChanged();
        }
    }

    /// <summary>
    /// Web-UI equivalent of the tray menu's "Refresh names from wiki". Progress is
    /// reported via the page-by-page callback <see cref="WikiNameService.RefreshAsync"/>
    /// already supports; <see cref="Progress{T}"/> captures this circuit's synchronization
    /// context at construction time, so each report marshals back here on its own.
    /// </summary>
    private async Task RefreshNames()
    {
        _namesRefreshed = false;
        _namesError = null;
        _namesProgress = null;
        _refreshingNames = true;
        StateHasChanged();

        var progress = new Progress<string>(p =>
        {
            if (_disposed) return;
            _namesProgress = p;
            StateHasChanged();
        });

        IReadOnlyList<WikiRefreshCallerPipeline.Failure> failures = [];
        try
        {
            await RunOwnedAsync(async ct =>
            {
                failures = await WikiRefreshCallerPipeline.RunAsync(
                    () => State.Names.RefreshAsync(progress, ct: ct),
                    () => Places.RefreshAsync(progress, ct: ct),
                    Watcher.RequestPlaceResolution,
                    () =>
                    {
                        State.Rebuild();
                        RefreshDiagnostics();
                    },
                    ct);
            });

            var unexpectedFailure = failures.FirstOrDefault(failure =>
                !FormOperationErrors.TryGetMessage(failure.Exception, out _));
            if (unexpectedFailure is not null)
            {
                System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(unexpectedFailure.Exception).Throw();
            }

            if (failures.Count == 0)
            {
                _namesRefreshed = true;
            }
            else
            {
                _namesError = $"Could not download {string.Join(" or ", failures.Select(f => $"{f.Source} ({f.Exception.Message})"))} from the wiki.";
            }
        }
        catch (OperationCanceledException ex) when (OperationOwner.IsStopping || Lifetime.ApplicationStopping.IsCancellationRequested || _pageStopping.IsCancellationRequested)
        {
            // Component shutdown cancels and joins this owned task; it is not a success.
            System.Diagnostics.Trace.WriteLine($"Settings wiki refresh canceled during component shutdown: {ex.Message}");
        }
        catch (OperationCanceledException ex)
        {
            _namesError = $"Wiki refresh was canceled: {ex.Message}";
        }
        catch (Exception ex) when (FormOperationErrors.TryGetMessage(ex, out _))
        {
            _namesError = $"Could not refresh names from the wiki: {ex.Message}";
        }
        finally
        {
            _refreshingNames = false;
            if (!_disposed) StateHasChanged();
        }
    }

    /// <summary>
    /// One button drives the whole pipeline: check, and if something newer exists, download
    /// it and restart straight into it. There is no separate confirm step — same behaviour
    /// as the launch-time check in <c>TrayHost</c>, just triggered by hand instead of on
    /// startup.
    /// </summary>
    private async Task CheckForUpdate()
    {
        _updateError = null;
        _updateStatus = null;
        _checkingUpdate = true;
        StateHasChanged();

        try
        {
            await RunOwnedAsync(async ct =>
            {
                var info = await Updates.CheckForUpdateAsync(ct);
                if (info is null)
                {
                    await InvokeAsync(() =>
                    {
                        _updateStatus = $"Up to date (v{_currentVersion}).";
                        StateHasChanged();
                    });
                    return;
                }

                await InvokeAsync(() =>
                {
                    _checkingUpdate = false;
                    _downloadingUpdate = true;
                    _updateProgress = 0;
                    StateHasChanged();
                });

                var progress = new Progress<double>(p =>
                {
                    if (_disposed) return;
                    _updateProgress = p;
                    InvokeAsync(StateHasChanged);
                });

                var path = await Updates.DownloadAsync(info, progress, ct: ct);
                ct.ThrowIfCancellationRequested();
                await InvokeAsync(() =>
                {
                    _updateStatus = $"Restarting into {info.TagName}…";
                    StateHasChanged();
                });

                try
                {
                    UpdateService.InstallAndRestart(path);
                }
                catch (Exception ex) when (ex is System.ComponentModel.Win32Exception or InvalidOperationException)
                {
                    throw new IOException($"Could not start the updated application: {ex.Message}", ex);
                }

                Lifetime.StopApplication();
            });
        }
        catch (OperationCanceledException ex) when (OperationOwner.IsStopping || Lifetime.ApplicationStopping.IsCancellationRequested || _pageStopping.IsCancellationRequested)
        {
            System.Diagnostics.Trace.WriteLine($"Settings update operation canceled during shutdown: {ex.Message}");
        }
        catch (OperationCanceledException ex)
        {
            _updateError = $"Update operation was canceled: {ex.Message}";
        }
        catch (Exception ex) when (FormOperationErrors.TryGetMessage(ex, out _))
        {
            _updateError = $"Could not check or install the update: {ex.Message}";
        }
        finally
        {
            _checkingUpdate = false;
            _downloadingUpdate = false;
            if (!_disposed) StateHasChanged();
        }
    }
}
