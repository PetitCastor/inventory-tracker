<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- WinExe keeps the tray app from flashing a console window. The CLI paths
         re-attach to the parent console themselves, so scan mode still prints. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>InventoryTracker</RootNamespace>
    <AssemblyName>InventoryTracker</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\assets\InventoryTracker.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\InventoryTracker.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Microsoft.Data.Sqlite 10.0.0 pulls SQLitePCLRaw 2.1.11, which carries
         GHSA-2m69-gcr7-jv3q. Pin the bundle forward past the advisory. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <!--
    Embed the Blazor startup script instead of letting it ship as a loose static
    web asset. Two reasons:
      1. The SDK target that registers it is gated on OutputType == 'Exe', and this
         is a WinExe so the tray never flashes a console window. Without this the
         script is simply absent and no interactive circuit is ever established.
      2. Static web assets are written next to the executable on publish, which
         would defeat the single-file output.
    BlazorFrameworkStaticWebAssetRoot comes from the framework assets package and is
    only set once NuGet's .targets are imported, so this has to run as a target.
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(NuGetPackageRoot)microsoft.aspnetcore.app.internal.assets\*\_framework\blazor.web.js"
                      LogicalName="blazor.web.js" />
  </ItemGroup>

  <!-- Embedding is easy to lose silently: the app would still serve pages, they
       would just never respond to input. Fail the build instead. -->
  <Target Name="VerifyBlazorScriptEmbedded" BeforeTargets="CoreCompile">
    <Error Condition="'@(EmbeddedResource)' == ''"
           Text="blazor.web.js was not found under '$(NuGetPackageRoot)microsoft.aspnetcore.app.internal.assets'. Without it the UI renders but never becomes interactive." />
  </Target>

</Project>
