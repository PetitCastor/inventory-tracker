@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject TrackerState State

<PageTitle>Find — Star Citizen inventory</PageTitle>

<h1>What is held where</h1>

<input class="search" type="search" placeholder="Search by name, e.g. &quot;multi-tool&quot; or &quot;CRUZ&quot;"
       @bind="_query" @bind:event="oninput" @bind:after="Refilter" autofocus />

@if (_results.Count == 0)
{
    <p class="empty">
        @(string.IsNullOrWhiteSpace(_query)
            ? "No items tracked yet. The tracker reads Star Citizen's logs as you play."
            : $"Nothing matching “{_query}”.")
    </p>
}
else
{
    <p class="count">@_results.Count item@(_results.Count == 1 ? "" : "s") in @_groups.Count place@(_groups.Count == 1 ? "" : "s")</p>

    @foreach (var group in _groups)
    {
        <section class="place">
            <h2>@group.Label <span class="badge-count">@group.Items.Count</span></h2>

            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Held in</th>
                        <th>Last moved</th>
                        <th>Confidence</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in group.Items)
                {
                    <tr>
                        <td>
                            <a href="@($"item/{item.Holding.Geid}")">@item.Display</a>
                            @if (item.Name.Match == NameMatch.None)
                            {
                                <span class="unnamed" title="Not found in the wiki catalogue">?</span>
                            }
                        </td>
                        <td class="chain">@item.Holding.Where</td>
                        <td class="when" title="@item.Holding.LastMove.ToString("u")">
                            @Ago(item.Holding.LastMove)
                        </td>
                        <td>
                            <span class="conf conf-@item.Holding.Confidence.ToString().ToLowerInvariant()"
                                  title="@string.Join("; ", item.Holding.Caveats)">
                                @item.Holding.Confidence
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    }
}

@code {
    private sealed record Group(string Label, List<NamedHolding> Items);

    private string _query = "";
    private IReadOnlyList<NamedHolding> _results = [];
    private List<Group> _groups = [];

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Refilter();
    }

    private void Refilter()
    {
        _results = State.Find(_query);

        // Group on the root's identity, not its name: several different SCU boxes share
        // the same class name and are genuinely different places.
        _groups = _results
            .GroupBy(h => (h.Holding.Root?.Kind, h.Holding.Root?.Key))
            .Select(g => new Group(Label(g.First()), g.OrderBy(h => h.Display).ToList()))
            .OrderByDescending(g => g.Items.Count)
            .ToList();
    }

    private static string Label(NamedHolding h) => h.Holding.Root?.Label ?? "Unknown";

    private static string Ago(DateTimeOffset when)
    {
        var span = DateTimeOffset.UtcNow - when;
        return span switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalHours: < 1 } => $"{span.TotalMinutes:F0} min ago",
            { TotalDays: < 1 } => $"{span.TotalHours:F0} h ago",
            { TotalDays: < 30 } => $"{span.TotalDays:F0} d ago",
            _ => when.ToString("yyyy-MM-dd"),
        };
    }

    private void OnChanged() => InvokeAsync(() => { Refilter(); StateHasChanged(); });

    public void Dispose() => State.Changed -= OnChanged;
}
